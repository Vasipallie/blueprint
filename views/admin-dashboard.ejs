<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Atlas Admin | Blueprint</title>
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7;   src: url('/resources/mc7.woff2')  format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }
        body, html {
            margin:0; padding:0; height:100%;
            overflow-x:hidden; overflow-y:auto;
            font-family: mcten, monospace;
            font-size: clamp(16px, 2.5vw, 22px);
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            line-height:1.4;
            background:#0a0a0a;
            color:#DDD;
        }
        a { color:#66aaff; text-decoration:none; cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }
        a:hover { color:#FFFFA0; }
        button { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        ::-webkit-scrollbar { width:8px; }
        ::-webkit-scrollbar-track { background:#0a0a0a; }
        ::-webkit-scrollbar-thumb { background:#333; border-radius:4px; }
        ::-webkit-scrollbar-thumb:hover { background:#555; }

        .bg-video {
            position:fixed; top:50%; left:50%;
            transform:translate(-50%,-50%);
            min-width:100%; min-height:100%;
            width:auto; height:auto;
            z-index:-1; object-fit:cover; opacity:0.2;
        }

        .navbar {
            position:fixed; top:0; left:0; right:0; height:56px;
            background:linear-gradient(180deg,#1a1a1ae8,#0a0a0aee);
            border-bottom:2px solid #333;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2, 0 4px 20px #0008;
            display:flex; justify-content:space-between; align-items:center;
            padding:0 1.5rem; z-index:100;
        }
        .nav-brand { display:flex; align-items:center; gap:.8rem; }
        .nav-logo { height:36px; image-rendering:pixelated; }
        .nav-title {
            color:#FFFFA0; font-family:'mc7',monospace;
            font-size:1.2rem; text-shadow:2px 2px #000A;
            letter-spacing:.05em;
        }
        .nav-links { display:flex; gap:.6rem; align-items:center; }
        .nav-btn {
            padding:.4rem .9rem;
            border:2px solid #444;
            background:#3a3a3a url('/resources/bgbtn.png') center/cover;
            image-rendering:pixelated;
            color:#DDD; font-family:'mc7',monospace; font-size:.75rem;
            cursor: url('/resources/crosshair-32.png') 16 16, pointer;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF5;
            text-decoration:none; transition:all .15s;
        }
        .nav-btn:hover {
            color:#FFFFA0; border-color:#FFFFA0;
            transform:translateY(-1px);
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF5, 0 2px 8px #FFFFA033;
        }
        .nav-btn:active { transform:translateY(1px); }
        .nav-btn.danger { background-image:none; background-color:rgba(160,40,40,0.85); color:#FFD2D2; }
        .nav-btn.danger:hover { border-color:#ff6666; color:#fff; }

        .main {
            margin-top:56px; padding:1.5rem 2rem 3rem;
            min-height:calc(100vh - 56px);
            max-width:1400px; margin-left:auto; margin-right:auto;
        }

        .hero-banner {
            background:linear-gradient(135deg,#1a0a2a88,#0a1a2a88);
            border:2px solid #333;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1, 0 4px 20px #0004;
            padding:1.5rem 2rem; margin-bottom:1.5rem;
            display:flex; align-items:center; gap:1.5rem;
            border-radius:4px;
        }
        .hero-icon { font-size:3rem; }
        .hero-text h1 {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1.3rem;
            text-shadow:2px 2px #000A; margin:0 0 .3rem 0;
        }
        .hero-text p { color:#AAA; font-size:.8rem; margin:0; line-height:1.5; }
        .hero-text .email-tag { color:#90EE90; font-family:'mc7',monospace; font-size:.75rem; }

        .stats-bar {
            display:grid;
            grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
            gap:.8rem; margin-bottom:1.5rem;
        }
        .stat-card {
            background:linear-gradient(180deg,#141414f0,#0e0e0ef0);
            border:2px solid #2a2a2a;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2;
            padding:1rem 1.2rem; text-align:center;
            border-radius:4px; transition:border-color .2s;
        }
        .stat-card:hover { border-color:#444; }
        .stat-label {
            color:#777; font-family:'mc7',monospace; font-size:.65rem;
            text-transform:uppercase; letter-spacing:.1em; margin-bottom:.3rem;
        }
        .stat-value {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1.6rem;
            text-shadow:2px 2px #000A;
        }

        .section-title {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1.1rem;
            text-shadow:2px 2px #000A; margin:0 0 1rem 0;
        }

        .action-grid {
            display:grid;
            grid-template-columns:repeat(auto-fill, minmax(280px,1fr));
            gap:1rem;
        }
        .action-card {
            background:linear-gradient(180deg,#141414f0,#0a0a0af0);
            border:2px solid #2a2a2a;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2;
            padding:1.2rem; position:relative;
            cursor: url('/resources/crosshair-32.png') 16 16, pointer;
            transition:all .2s; border-radius:4px;
            text-decoration:none; display:block; color:#DDD;
        }
        .action-card:hover {
            border-color:#FFFFA0;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFFFA018, 0 2px 12px #FFFFA011;
            transform:translateY(-2px); color:#DDD;
        }
        .action-icon { font-size:2rem; margin-bottom:.5rem; display:block; }
        .action-title {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1rem;
            text-shadow:2px 2px #000A; margin:0 0 .4rem 0;
        }
        .action-desc { color:#AAA; font-size:.75rem; line-height:1.5; margin:0; }
        .action-go {
            display:inline-block; margin-top:.8rem; padding:.35rem .8rem;
            background:linear-gradient(180deg,#2a2a2a,#1a1a1a);
            border:1px solid #444; color:#66ff66;
            font-family:'mc7',monospace; font-size:.65rem;
            border-radius:2px; transition:all .15s;
        }
        .action-card:hover .action-go { border-color:#66ff66; box-shadow:0 0 8px #66ff6622; }

        .scanner-wrap {
            margin-top: 1.3rem;
            background: linear-gradient(180deg,#121212f0,#0a0a0af0);
            border: 2px solid #2a2a2a;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF2;
            border-radius: 4px;
            padding: 1rem;
        }

        .scanner-grid {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 1rem;
            align-items: start;
        }

        #qrReader {
            width: 100%;
            min-height: 260px;
            border: 2px solid #333;
            background: #080808;
            padding: 0.25rem;
        }

        .scanner-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 0.7rem;
        }

        .scanner-status {
            border: 2px solid #2a2a2a;
            background: rgba(0,0,0,0.35);
            padding: .65rem .75rem;
            font-family: 'mc7', monospace;
            font-size: .7rem;
            color: #DDD;
            min-height: 48px;
        }

        .scanner-status.ok { color: #90EE90; border-color: #2a5a2a; }
        .scanner-status.err { color: #ff8c8c; border-color: #5a2a2a; }
        .scanner-result {
            margin-top: .6rem;
            font-family: 'mc7', monospace;
            font-size: .68rem;
            color: #66aaff;
            word-break: break-all;
        }

        .sim-footer {
            text-align:center; padding:2rem 1rem; margin-top:2rem;
            border-top:1px solid #222; color:#555; font-size:.7rem;
        }
        .sim-footer a { color:#66aaff; }

        @media (max-width:768px) {
            .navbar { padding:0 1rem; }
            .nav-title { font-size:.9rem; }
            .main { padding:1rem; }
            .hero-banner { flex-direction:column; text-align:center; padding:1rem; }
            .hero-icon { font-size:2rem; }
            .action-grid { grid-template-columns:1fr; }
            .stats-bar { grid-template-columns:1fr; }
            .scanner-grid { grid-template-columns: 1fr; }
        }
        @media (hover: none) and (pointer: coarse) {
            html, body, a, button { cursor: auto; }
        }
    </style>
    <link rel="icon" type="image/png" href="/resources/logo.png">
</head>
<body>
    <video class="bg-video" autoplay muted loop playsinline>
        <source src="https://7oaoepmc5nhfkhkk.public.blob.vercel-storage.com/bcgk.mp4" type="video/mp4">
    </video>

    <nav class="navbar">
        <div class="nav-brand">
            <img src="/resources/logo.png" alt="Blueprint" class="nav-logo">
            <span class="nav-title">ATLAS ADMIN</span>
        </div>
        <div class="nav-links">
            <a href="/dashboard" class="nav-btn">📋 Dashboard</a>
            <a href="/logout" class="nav-btn danger">⏏ Logout</a>
        </div>
    </nav>

    <main class="main">
        <div class="hero-banner">
            <span class="hero-icon">🛡️</span>
            <div class="hero-text">
                <h1>Admin Control Panel</h1>
                <p class="email-tag"><%= user.email %></p>
                <p>Manage teams, emails, submissions, and electronics loans for the Blueprint event.</p>
            </div>
        </div>

        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-label">Total Teams</div>
                <div class="stat-value"><%= teamCount %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Submissions</div>
                <div class="stat-value"><%= submissionCount %></div>
            </div>
        </div>

        <h2 class="section-title">Quick Actions</h2>
        <div class="action-grid">
            <a href="/admin/teams" class="action-card">
                <span class="action-icon">👥</span>
                <div class="action-title">Teams</div>
                <p class="action-desc">Create team credentials and email onboarding details.</p>
                <span class="action-go">▶ OPEN TEAMS</span>
            </a>
            <a href="/admin/emails" class="action-card">
                <span class="action-icon">✉️</span>
                <div class="action-title">Emails</div>
                <p class="action-desc">Compose and send formatted updates to participants.</p>
                <span class="action-go">▶ OPEN EMAILS</span>
            </a>
            <a href="/admin/submissions" class="action-card">
                <span class="action-icon">📦</span>
                <div class="action-title">Submissions</div>
                <p class="action-desc">Review all submitted projects and resource links.</p>
                <span class="action-go">▶ VIEW ALL</span>
            </a>
            <a href="/admin/operations" class="action-card">
                <span class="action-icon">🍱</span>
                <div class="action-title">Food and Attendance</div>
                <p class="action-desc">Search teams or members, mark food sessions, and track attendance with manual sheet or QR.</p>
                <span class="action-go">▶ OPEN OPS</span>
            </a>
            <a href="/admin/loans" class="action-card">
                <span class="action-icon">🔌</span>
                <div class="action-title">Electronics Loans</div>
                <p class="action-desc">Track pending requests, fulfilled pickups, returned items, and inventory stock in one place.</p>
                <span class="action-go">▶ OPEN LOANS</span>
            </a>
        </div>

        <section class="scanner-wrap">
            <h2 class="section-title">QR Scanner</h2>
            <div class="scanner-grid">
                <div id="qrReader"></div>
                <div>
                    <div class="scanner-actions">
                        <button class="nav-btn" type="button" id="startScanBtn">Start Scan</button>
                        <button class="nav-btn" type="button" id="stopScanBtn">Stop Scan</button>
                    </div>
                    <div id="scannerStatus" class="scanner-status">Scan attendance QR here. If it contains an attendance URL, this dashboard will call it immediately.</div>
                    <div id="scannerResult" class="scanner-result"></div>
                </div>
            </div>
        </section>

        <div class="sim-footer">
            Blueprint | GIIS Robotics Club &mdash; Admin Panel
        </div>
    </main>

    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script>
        const startScanBtn = document.getElementById('startScanBtn');
        const stopScanBtn = document.getElementById('stopScanBtn');
        const scannerStatus = document.getElementById('scannerStatus');
        const scannerResult = document.getElementById('scannerResult');

        let qrScanner = null;
        let scannerRunning = false;
        let lastScan = '';

        function setScannerStatus(message, type = '') {
            scannerStatus.className = 'scanner-status';
            if (type) {
                scannerStatus.classList.add(type);
            }
            scannerStatus.textContent = message;
        }

        function normalizeScanTarget(text) {
            const raw = String(text || '').trim();
            if (!raw) {
                return '';
            }

            if (raw.startsWith('http://') || raw.startsWith('https://')) {
                return raw;
            }

            if (raw.startsWith('/')) {
                return window.location.origin + raw;
            }

            return raw;
        }

        async function handleScan(decodedText) {
            const normalized = normalizeScanTarget(decodedText);

            if (!normalized || normalized === lastScan) {
                return;
            }

            lastScan = normalized;
            scannerResult.textContent = normalized;

            if (normalized.startsWith('http://') || normalized.startsWith('https://')) {
                try {
                    const response = await fetch(normalized, { method: 'GET' });
                    const body = await response.text();
                    if (response.ok) {
                        setScannerStatus(body || 'QR URL executed successfully.', 'ok');
                    } else {
                        setScannerStatus('QR request failed: ' + body, 'err');
                    }
                } catch (error) {
                    setScannerStatus('Failed to call scanned URL: ' + error.message, 'err');
                }
            } else {
                setScannerStatus('QR scanned, but not a URL. Copy value from result panel.', 'err');
            }
        }

        async function startScanner() {
            if (scannerRunning) {
                return;
            }

            if (typeof Html5Qrcode === 'undefined') {
                setScannerStatus('Scanner library failed to load. Refresh and try again.', 'err');
                return;
            }

            if (!qrScanner) {
                qrScanner = new Html5Qrcode('qrReader');
            }

            try {
                await qrScanner.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: { width: 220, height: 220 } },
                    handleScan,
                    () => {}
                );

                scannerRunning = true;
                setScannerStatus('Scanner started. Point camera at QR code.', 'ok');
            } catch (error) {
                setScannerStatus('Unable to start scanner: ' + error.message, 'err');
            }
        }

        async function stopScanner() {
            if (!qrScanner || !scannerRunning) {
                return;
            }

            try {
                await qrScanner.stop();
                scannerRunning = false;
                setScannerStatus('Scanner stopped.');
            } catch (error) {
                setScannerStatus('Failed to stop scanner: ' + error.message, 'err');
            }
        }

        startScanBtn.addEventListener('click', startScanner);
        stopScanBtn.addEventListener('click', stopScanner);
    </script>
</body>
</html>
