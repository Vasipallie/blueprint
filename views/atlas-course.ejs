<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title><%= course.name || course.project_name || 'Course Article' %> | Atlas</title>
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background-image: url('/resources/background.jpg');
            background-size: cover;
            background-position: center center;
            color: #DDD;
        }

        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.1rem;
        }

        .top {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20,20,30,0.82), rgba(0,0,0,0.82));
            box-shadow: inset -3px -6px rgba(0,0,0,0.45), inset 3px 3px rgba(255,255,255,0.06);
            padding: 0.9rem;
            margin-bottom: 0.9rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            font-size: clamp(18px, 2.5vw, 28px);
        }

        .subtitle {
            margin: 0.2rem 0 0;
            font-family: 'mc7', monospace;
            color: #9BCBFF;
            font-size: 0.8rem;
        }

        .mc-link {
            border: 2px solid #000;
            background: #999 url('/resources/bgbtn.png') center / cover;
            font-family: 'mc7', monospace;
            color: #DDD;
            text-shadow: 2px 2px #000A;
            padding: 0.6rem 0.8rem;
            text-decoration: none;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
        }

        .article-card {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20,20,30,0.84), rgba(0,0,0,0.82));
            box-shadow: inset -3px -6px rgba(0,0,0,0.45), inset 3px 3px rgba(255,255,255,0.06);
            padding: 1rem;
        }

        .article {
            border: 4px solid #000;
            background: #fff;
            color: #111;
            box-shadow: inset -3px -6px rgba(0,0,0,0.3), inset 3px 3px rgba(255,255,255,0.6);
            padding: clamp(16px, 3vw, 30px);
            line-height: 1.65;
            font-family: Arial, Helvetica, sans-serif;
            overflow-wrap: anywhere;
        }

        .article h1, .article h2, .article h3 { color: #1f2430; }
        .article a { color: #2d6cdf; }
        .article pre {
            background: #f5f7fa;
            border: 1px solid #d8dee6;
            padding: 0.8rem;
            overflow-x: auto;
        }

        .article img {
            max-width: 100%;
            height: auto;
        }

        .message {
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            padding: 0.7rem 0.8rem;
            font-family: 'mc7', monospace;
            color: #DDD;
            font-size: 0.82rem;
        }

        @media (max-width: 820px) {
            .page {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
            }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <header class="top">
            <div>
                <h1 class="title"><%= course.name || course.project_name || course.title || 'Course Article' %></h1>
                <p class="subtitle">Welcome <%= teamName %></p>
            </div>
            <a class="mc-link" href="/dashboard">← Back to Dashboard</a>
        </header>

        <section class="article-card">
            <main class="article" id="articleRoot">
                <% if (course.html_content) { %>
                    <%- course.html_content %>
                <% } else if (course.description || course.project_description) { %>
                    <h2>Overview</h2>
                    <p><%= course.description || course.project_description %></p>
                <% } else { %>
                    <div class="message">No article content found for this course.</div>
                <% } %>
            </main>
        </section>
    </div>
</body>
</html>
