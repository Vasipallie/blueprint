<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Atlas Dashboard | Blueprint</title>
    <style>
        @font-face { font-family: mcten; src: url('resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7;   src: url('resources/mc7.woff2')  format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }
        body, html {
            margin:0; padding:0; height:100%;
            overflow-x:hidden; overflow-y:auto;
            font-family: mcten, monospace;
            font-size: clamp(16px, 2.5vw, 22px);
            cursor: url('resources/crosshair-32.png') 16 16, crosshair;
            line-height:1.4;
            background:#0a0a0a;
            color:#DDD;
        }
        a { color:#66aaff; text-decoration:none; cursor: url('resources/crosshair-32.png') 16 16, crosshair; }
        a:hover { color:#FFFFA0; }
        button, input, textarea { cursor: url('resources/crosshair-32.png') 16 16, crosshair; }

        ::-webkit-scrollbar { width:8px; }
        ::-webkit-scrollbar-track { background:#0a0a0a; }
        ::-webkit-scrollbar-thumb { background:#333; border-radius:4px; }
        ::-webkit-scrollbar-thumb:hover { background:#555; }

        .bg-video {
            position:fixed; top:50%; left:50%;
            transform:translate(-50%,-50%);
            min-width:100%; min-height:100%;
            width:auto; height:auto;
            z-index:-1; object-fit:cover; opacity:0.2;
        }

        /* ── NAVBAR ───────────────────────────────────── */
        .navbar {
            position:fixed; top:0; left:0; right:0; height:56px;
            background:linear-gradient(180deg,#1a1a1ae8,#0a0a0aee);
            border-bottom:2px solid #333;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2, 0 4px 20px #0008;
            display:flex; justify-content:space-between; align-items:center;
            padding:0 1.5rem; z-index:100;
        }
        .nav-brand { display:flex; align-items:center; gap:.8rem; }
        .nav-logo { height:36px; image-rendering:pixelated; }
        .nav-title {
            color:#FFFFA0; font-family:'mc7',monospace;
            font-size:1.2rem; text-shadow:2px 2px #000A;
            letter-spacing:.05em;
        }
        .nav-links { display:flex; gap:.6rem; align-items:center; flex-wrap:wrap; }
        .nav-btn {
            padding:.4rem .9rem;
            border:2px solid #444;
            background:#3a3a3a url('resources/bgbtn.png') center/cover;
            image-rendering:pixelated;
            color:#DDD; font-family:'mc7',monospace; font-size:.75rem;
            cursor: url('resources/crosshair-32.png') 16 16, pointer;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF5;
            text-decoration:none; transition:all .15s;
        }
        .nav-btn:hover {
            color:#FFFFA0; border-color:#FFFFA0;
            transform:translateY(-1px);
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF5, 0 2px 8px #FFFFA033;
        }
        .nav-btn:active { transform:translateY(1px); }
        .nav-btn.danger { background-image:none; background-color:rgba(160,40,40,0.85); color:#FFD2D2; }
        .nav-btn.danger:hover { border-color:#ff6666; color:#fff; }

        /* ── MAIN ────────────────────────────────────── */
        .main {
            margin-top:56px; padding:1.5rem 2rem 3rem;
            min-height:calc(100vh - 56px);
            max-width:1400px; margin-left:auto; margin-right:auto;
        }

        /* ── HERO ────────────────────────────────────── */
        .hero-banner {
            background:linear-gradient(135deg,#0a1a2a88,#0a2a1a88);
            border:2px solid #333;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1, 0 4px 20px #0004;
            padding:1.5rem 2rem; margin-bottom:1.5rem;
            display:flex; align-items:center; gap:1.5rem;
            border-radius:4px;
        }
        .hero-icon { font-size:3rem; }
        .hero-text h1 {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1.3rem;
            text-shadow:2px 2px #000A; margin:0 0 .3rem 0;
        }
        .hero-text p { color:#AAA; font-size:.8rem; margin:0; line-height:1.5; }
        .hero-text .team-tag { color:#90EE90; font-family:'mc7',monospace; font-size:.85rem; }

        /* ── TABS ─────────────────────────────────────── */
        .tabs {
            display:flex; gap:0; margin-bottom:0; flex-wrap:wrap;
        }
        .tab-btn {
            padding:.55rem 1.2rem;
            border:2px solid #333; border-bottom:none;
            background:linear-gradient(180deg,#1a1a1a,#111);
            color:#777; font-family:'mc7',monospace; font-size:.75rem;
            cursor: url('resources/crosshair-32.png') 16 16, pointer;
            transition:all .2s; border-radius:4px 4px 0 0;
        }
        .tab-btn:hover { color:#DDD; background:#222; }
        .tab-btn.active {
            color:#FFFFA0; border-color:#FFFFA0; border-bottom-color:transparent;
            background:linear-gradient(180deg,#1a1a1a,#0a0a0a);
            box-shadow:0 -2px 8px #FFFFA011;
        }
        .tab-content {
            display:none; border:2px solid #333; border-top:none; padding:1.2rem;
            background:rgba(10,10,10,.85); border-radius:0 4px 4px 4px;
        }
        .tab-content.active { display:block; }

        /* ── SECTION TITLE ────────────────────────────── */
        .section-title {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1.1rem;
            text-shadow:2px 2px #000A; margin:0 0 1rem 0;
        }

        /* ── STATUS BOX ───────────────────────────────── */
        .status-box {
            background:linear-gradient(180deg,#141414f0,#0e0e0ef0);
            border:2px solid #2a2a2a; padding:.8rem 1rem;
            font-family:'mc7',monospace; font-size:.8rem; color:#AAA;
            border-radius:4px; margin-bottom:1rem;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1;
        }
        .status-box--ok { color:#90EE90; border-color:#2a5a2a; }
        .status-box--err { color:#ff8c8c; border-color:#5a2a2a; }

        /* ── TIMELINE ─────────────────────────────────── */
        .day-header {
            color:#90EE90; font-family:'mc7',monospace; font-size:.9rem;
            margin:1.2rem 0 .8rem; padding:.6rem .9rem;
            background:linear-gradient(135deg,rgba(50,100,50,0.25),rgba(20,60,20,0.15));
            border:2px solid #2a4a2a;
            border-radius:4px;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1;
        }
        .timeline { position:relative; padding-left:40px; }
        .timeline::before {
            content:''; position:absolute; left:8px; top:0; bottom:0;
            width:3px; background:linear-gradient(to bottom,#FFFFA0,#FFE066,#FFFFA0); opacity:.5;
        }
        .timeline-item { position:relative; padding-bottom:1rem; }
        .timeline-item::before {
            content:''; position:absolute; left:-28px; top:6px;
            width:12px; height:12px; background:#FFFFA0; border:2px solid #000;
        }
        .timeline-time { color:#FFFFA0; font-family:'mc7',monospace; font-size:.75rem; }
        .timeline-title { color:#FFF; font-family:'mc7',monospace; font-size:.85rem; }
        .timeline-desc { color:#AAA; font-size:.75rem; }

        /* ── FORMS ────────────────────────────────────── */
        .form-grid { display:grid; grid-template-columns:1fr; gap:1rem; }
        .label {
            display:block; font-family:'mc7',monospace; color:#DDD;
            margin-bottom:.4rem; font-size:.8rem;
        }
        .input, .textarea {
            width:100%;
            border:2px solid #333;
            background:linear-gradient(180deg,#141414,#0e0e0e);
            color:#FFF; font-family:'mc7',monospace;
            padding:.7rem .85rem; font-size:.8rem;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1;
            border-radius:3px; transition:border-color .2s;
        }
        .input:focus, .textarea:focus {
            outline:none; border-color:#FFFFA0;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1, 0 0 8px #FFFFA022;
        }
        .textarea { min-height:140px; resize:vertical; }
        .small-text {
            display:block; margin-top:.25rem; color:#777;
            font-family:'mc7',monospace; font-size:.6rem;
        }
        .submit-btn {
            padding:.5rem 1.5rem;
            background:linear-gradient(180deg,#2a6a2a,#1a4a1a);
            border:2px solid #66ff66; color:#66ff66;
            font-family:'mc7',monospace; font-size:.8rem;
            cursor: url('resources/crosshair-32.png') 16 16, pointer;
            transition:all .2s; border-radius:4px;
        }
        .submit-btn:hover {
            background:linear-gradient(180deg,#3a8a3a,#2a6a2a);
            box-shadow:0 0 12px #66ff6633;
        }

        /* ── COURSE GRID ──────────────────────────────── */
        .courses-grid {
            display:grid;
            grid-template-columns:repeat(auto-fill, minmax(280px,1fr));
            gap:1rem;
        }
        .course-card {
            background:linear-gradient(180deg,#141414f0,#0a0a0af0);
            border:2px solid #2a2a2a;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2;
            padding:1.1rem; border-radius:4px;
            transition:all .2s;
        }
        .course-card:hover {
            border-color:#FFFFA0;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFFFA018, 0 2px 12px #FFFFA011;
            transform:translateY(-2px);
        }
        .course-name {
            margin:0 0 .3rem; font-family:'mc7',monospace;
            color:#FFFFA0; font-size:.9rem; text-shadow:2px 2px #000A;
        }
        .course-desc {
            margin:0 0 .6rem; color:#AAA; font-size:.75rem; line-height:1.5;
        }
        .course-link {
            display:inline-block; padding:.35rem .8rem;
            background:linear-gradient(180deg,#2a2a2a,#1a1a1a);
            border:1px solid #444; color:#66aaff;
            font-family:'mc7',monospace; font-size:.65rem;
            border-radius:2px; transition:all .15s; text-decoration:none;
        }
        .course-link:hover { border-color:#66aaff; color:#FFFFA0; box-shadow:0 0 8px #66aaff22; }

        /* ── SUBMISSIONS LIST ─────────────────────────── */
        .submission-list { display:grid; gap:.7rem; }
        .submission-item {
            background:linear-gradient(180deg,#141414f0,#0e0e0ef0);
            border:2px solid #2a2a2a; padding:.8rem 1rem;
            font-family:'mc7',monospace; color:#DDD; font-size:.8rem;
            border-radius:4px;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF1;
        }
        .submission-item strong { color:#FFFFA0; }

        /* ── FOOTER ───────────────────────────────────── */
        .sim-footer {
            text-align:center; padding:2rem 1rem; margin-top:2rem;
            border-top:1px solid #222; color:#555; font-size:.7rem;
        }
        .sim-footer a { color:#66aaff; }

        /* ── RESPONSIVE ───────────────────────────────── */
        @media (max-width:768px) {
            .navbar { padding:0 .8rem; }
            .nav-title { font-size:.9rem; }
            .main { padding:1rem; }
            .hero-banner { flex-direction:column; text-align:center; padding:1rem; }
            .hero-icon { font-size:2rem; }
            .courses-grid { grid-template-columns:1fr; }
        }
        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, textarea { cursor: auto; }
        }
    </style>
    <link rel="icon" type="image/png" href="resources/logo.png">
</head>
<body>
    <video class="bg-video" autoplay muted loop playsinline>
        <source src="https://7oaoepmc5nhfkhkk.public.blob.vercel-storage.com/bcgk.mp4" type="video/mp4">
    </video>

    <nav class="navbar">
        <div class="nav-brand">
            <img src="resources/logo.png" alt="Blueprint" class="nav-logo">
            <span class="nav-title">ATLAS</span>
        </div>
        <div class="nav-links">
            <% if (isAdmin) { %>
                <a class="nav-btn" href="/admin">🛡️ Admin</a>
            <% } %>
            <a href="/arduino" class="nav-btn">⚡ Arduino IDE</a>
            <a class="nav-btn danger" href="/logout">⏏ Logout</a>
        </div>
    </nav>

    <main class="main">
        <!-- Hero -->
        <div class="hero-banner">
            <span class="hero-icon">🚀</span>
            <div class="hero-text">
                <h1>Welcome Back, <%= teamName %></h1>
                <p class="team-tag">Blueprint Atlas Dashboard</p>
                <p>View your timeline, submit projects, and access course materials.</p>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" data-tab="overview">📋 OVERVIEW</button>
            <button class="tab-btn" data-tab="submit">📤 SUBMIT</button>
            <button class="tab-btn" data-tab="courses">📚 COURSES</button>
        </div>

        <!-- Overview Tab -->
        <div class="tab-content active" id="panel-overview">
            <h2 class="section-title">Event Timeline</h2>

            <h3 class="day-header">Day 1 — March 30</h3>
            <div class="timeline">
                <div class="timeline-item"><div class="timeline-time">8:30 AM - 9:00 AM</div><div class="timeline-title">Registration</div><div class="timeline-desc">Teams arrive and check in.</div></div>
                <div class="timeline-item"><div class="timeline-time">9:00 AM - 9:40 AM</div><div class="timeline-title">Opening Ceremony</div><div class="timeline-desc">Theme introduction and briefing.</div></div>
                <div class="timeline-item"><div class="timeline-time">9:40 AM - 11:00 AM</div><div class="timeline-title">Workshop Session 1</div><div class="timeline-desc">Core concept workshop.</div></div>
                <div class="timeline-item"><div class="timeline-time">11:15 AM - 1:00 PM</div><div class="timeline-title">Workshop Session 2</div><div class="timeline-desc">Specialized tracks.</div></div>
                <div class="timeline-item"><div class="timeline-time">2:50 PM - 6:30 PM</div><div class="timeline-title">Build Sessions</div><div class="timeline-desc">Hands-on build and prototype.</div></div>
            </div>

            <h3 class="day-header">Day 2 — March 31</h3>
            <div class="timeline">
                <div class="timeline-item"><div class="timeline-time">9:00 AM - 4:00 PM</div><div class="timeline-title">Final Build</div><div class="timeline-desc">Complete and polish your project.</div></div>
                <div class="timeline-item"><div class="timeline-time">4:00 PM - 5:30 PM</div><div class="timeline-title">Judging Session</div><div class="timeline-desc">Present to judges and tech team.</div></div>
                <div class="timeline-item"><div class="timeline-time">5:45 PM - 6:30 PM</div><div class="timeline-title">Awards Ceremony</div><div class="timeline-desc">Awards and closing celebration.</div></div>
            </div>

            <h2 class="section-title" style="margin-top:1.5rem;">Your Submissions</h2>
            <% if (submissions.length === 0) { %>
                <div class="status-box">No submissions yet. Use the Submit tab to add one.</div>
            <% } %>
            <div class="submission-list">
                <% submissions.forEach((item) => { %>
                    <div class="submission-item">
                        <strong><%= item.project_name || 'Untitled Project' %></strong><br>
                        GitHub: <%= item.github_repository || 'N/A' %>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Submit Tab -->
        <div class="tab-content" id="panel-submit">
            <h2 class="section-title">Submit Project</h2>
            <% if (typeof query !== 'undefined' && query.submit === 'success') { %>
                <div class="status-box status-box--ok">Project submitted successfully!</div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.submit === 'error') { %>
                <div class="status-box status-box--err">Project submission failed. Try again.</div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.submit === 'missing') { %>
                <div class="status-box status-box--err">Please fill all required fields.</div>
            <% } %>
            <form method="POST" action="/dashboard/projects" class="form-grid">
                <div>
                    <label class="label" for="projectName">Project Name</label>
                    <input class="input" id="projectName" name="projectName" placeholder="Enter your project name..." required>
                </div>
                <div>
                    <label class="label" for="githubRepository">GitHub Repository</label>
                    <input class="input" id="githubRepository" name="githubRepository" type="url" placeholder="https://github.com/username/repo..." required>
                    <span class="small-text">Enter the full URL to your GitHub repository</span>
                </div>
                <div>
                    <label class="label" for="pitchDeckLink">Pitch Deck Link (Google Drive / Canva)</label>
                    <input class="input" id="pitchDeckLink" name="pitchDeckLink" type="url" placeholder="https://docs.google.com/presentation/..." required>
                    <span class="small-text">Make sure link sharing is enabled.</span>
                </div>
                <div>
                    <label class="label" for="projectDescription">Project Description</label>
                    <textarea class="textarea" id="projectDescription" name="projectDescription" placeholder="Describe your project..." required></textarea>
                </div>
                <div>
                    <button class="submit-btn" type="submit">⬆ SUBMIT PROJECT</button>
                </div>
            </form>
        </div>

        <!-- Courses Tab -->
        <div class="tab-content" id="panel-courses">
            <h2 class="section-title">Courses</h2>
            <% if (typeof query !== 'undefined' && query.course === 'not-found') { %>
                <div class="status-box status-box--err">Selected article was not found.</div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.course === 'error') { %>
                <div class="status-box status-box--err">Could not load article. Please retry.</div>
            <% } %>
            <% if (courses.length === 0) { %>
                <div class="status-box">No courses available yet.</div>
            <% } %>
            <div class="courses-grid">
                <% courses.forEach((course) => {
                    const courseName = course.name || course.project_name || course.title || 'Untitled Course';
                    const courseDesc = course.description || course.project_description || 'No description available.';
                    const courseId = course.id;
                %>
                    <article class="course-card">
                        <h3 class="course-name"><%= courseName %></h3>
                        <p class="course-desc"><%= courseDesc %></p>
                        <% if (courseId) { %>
                            <a class="course-link" href="/dashboard/course/<%= courseId %>">▶ OPEN ARTICLE</a>
                        <% } else { %>
                            <div class="status-box status-box--err" style="margin:0;padding:.4rem .6rem;font-size:.65rem;">Course ID missing</div>
                        <% } %>
                    </article>
                <% }) %>
            </div>
        </div>

        <div class="sim-footer">
            Blueprint | GIIS Robotics Club &mdash; Atlas Dashboard
        </div>
    </main>

    <script>
        const tabButtons = document.querySelectorAll('.tab-btn[data-tab]');
        const panels = {
            overview: document.getElementById('panel-overview'),
            submit: document.getElementById('panel-submit'),
            courses: document.getElementById('panel-courses')
        };

        function activateTab(tab) {
            tabButtons.forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
            Object.entries(panels).forEach(([key, panel]) => {
                panel.classList.toggle('active', key === tab);
            });
        }

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => activateTab(btn.dataset.tab));
        });

        const params = new URLSearchParams(window.location.search);
        if (params.get('submit')) activateTab('submit');
        if (params.get('course')) activateTab('courses');
    </script>
</body>
</html>
