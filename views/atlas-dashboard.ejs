<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Atlas Dashboard | Blueprint</title>
    <style>
        @font-face { font-family: mcten; src: url('resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('resources/mc7.woff2') format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            font-size: clamp(17px, 2.15vw, 22px);
            cursor: url('resources/crosshair-32.png') 16 16, crosshair;
            background: radial-gradient(ellipse at top, #111321 0%, #040408 55%, #000000 100%);
            color: #DDD;
            overflow: hidden;
        }

        a, button, input, textarea { cursor: url('resources/crosshair-32.png') 16 16, crosshair; }

        .shell {
            height: 100vh;
            width: 100%;
            max-width: 1540px;
            margin: 0 auto;
            padding: 1rem;
        }

        .layout {
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 1rem;
        }

        .sidebar {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20, 20, 30, 0.82), rgba(0, 0, 0, 0.82));
            box-shadow: inset -3px -6px rgba(0, 0, 0, 0.45), inset 3px 3px rgba(255,255,255,0.06);
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            min-height: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 0.35rem;
        }

        .brand img {
            width: 78px;
            height: 78px;
            border-radius: 999px;
            border: 3px solid #000;
            object-fit: cover;
        }

        .brand-title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            font-size: clamp(24px, 2.2vw, 32px);
            letter-spacing: 0.08em;
        }

        .welcome {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #90EE90;
            text-shadow: 1px 1px #000A;
            font-size: 0.95rem;
        }

        .nav-col {
            display: flex;
            flex-direction: column;
            gap: 0.55rem;
            flex: 1;
            min-height: 0;
        }

        .nav-btn,
        .mc-link,
        .mc-danger,
        .course-link {
            width: 100%;
            border: 2px solid #000;
            background: #999 url('resources/bgbtn.png') center / cover;
            font-family: 'mc7', monospace;
            color: #DDD;
            text-shadow: 2px 2px #000A;
            padding: 0.82rem 0.95rem;
            text-decoration: none;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            font-size: 0.95rem;
            text-align: left;
            transition: border-color 0.15s ease, filter 0.15s ease;
        }

        .nav-btn:hover,
        .mc-link:hover,
        .mc-danger:hover,
        .course-link:hover,
        .nav-btn:focus-visible,
        .mc-link:focus-visible,
        .mc-danger:focus-visible,
        .course-link:focus-visible {
            border-color: #FFFFA0;
            filter: brightness(1.08);
            outline: none;
        }

        .nav-btn.is-active {
            color: #FFFFA0;
            border-color: #FFFFA0;
            background-color: rgba(100, 100, 255, 0.35);
        }

        .mc-danger {
            background-image: none;
            background-color: rgba(160, 40, 40, 0.8);
            color: #FFD2D2;
        }

        .sidebar-footer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 0.55rem;
        }

        .content {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20, 20, 30, 0.78), rgba(0, 0, 0, 0.75));
            box-shadow: inset -3px -6px rgba(0, 0, 0, 0.45), inset 3px 3px rgba(255, 255, 255, 0.06), 0 10px 30px rgba(0, 0, 0, 0.35);
            padding: 1.2rem;
            overflow-y: auto;
            min-height: 0;
        }

        .tab-panel { display: none; }
        .tab-panel.is-active { display: block; }

        .section-title {
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            margin: 0 0 1rem;
            font-size: clamp(24px, 2.8vw, 36px);
        }

        .status-box {
            margin-bottom: 1.2rem;
            padding: 0.95rem 1.1rem;
            border: 2px solid #000;
            background: rgba(0, 0, 0, 0.35);
            font-family: 'mc7', monospace;
            font-size: 0.95rem;
            color: #DDD;
        }

        .status-box--ok { color: #90EE90; }
        .status-box--err { color: #ff8c8c; }

        .timeline { position: relative; padding-left: 44px; }
        .timeline::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, #FFFFA0, #FFE066, #FFFFA0);
            opacity: 0.6;
        }

        .timeline-item { position: relative; padding-bottom: 1.2rem; }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -32px;
            top: 6px;
            width: 14px;
            height: 14px;
            background: #FFFFA0;
            border: 2px solid #000;
        }

        .timeline-time { color: #FFFFA0; font-family: 'mc7', monospace; font-size: 0.98rem; }
        .timeline-title { color: #FFF; font-family: 'mc7', monospace; font-size: 1.08rem; }
        .timeline-desc { color: #AAA; font-family: 'mc7', monospace; font-size: 0.92rem; }

        .day-header {
            color: #90EE90;
            font-family: 'mc7', monospace;
            font-size: 1.18rem;
            margin: 1.2rem 0 0.9rem;
            padding: 0.7rem 0.95rem;
            background: linear-gradient(145deg, rgba(50, 100, 50, 0.4), rgba(20, 60, 20, 0.3));
            border: 2px solid rgba(0, 0, 0, 0.6);
        }

        .form-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
        .label { display: block; font-family: 'mc7', monospace; color: #DDD; margin-bottom: 0.45rem; font-size: 0.97rem; }
        .input, .textarea {
            width: 100%;
            border: 2px solid #000;
            background: #333 url('resources/bgbtn.png') center / cover;
            color: #FFF;
            font-family: 'mc7', monospace;
            padding: 0.82rem 0.92rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF3;
            font-size: 1rem;
        }
        .textarea { min-height: 150px; resize: vertical; }
        .small-text { display: block; margin-top: 0.3rem; color: #AAA; font-family: 'mc7', monospace; font-size: 0.86rem; }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.1rem;
        }

        .course-card {
            border: 3px solid #000;
            background: linear-gradient(145deg, rgba(30,30,45,0.8), rgba(0,0,0,0.6));
            box-shadow: inset -2px -4px rgba(0,0,0,0.35), inset 2px 2px rgba(255,255,255,0.08);
            padding: 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        .course-name { margin: 0; font-family: 'mc7', monospace; color: #FFFFA0; font-size: 1.15rem; }
        .course-desc { margin: 0; font-family: 'mc7', monospace; color: #DDD; font-size: 0.94rem; line-height: 1.55; }

        .course-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .submission-list { display: grid; gap: 0.85rem; }
        .submission-item {
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            padding: 0.9rem 1rem;
            font-family: 'mc7', monospace;
            color: #DDD;
            font-size: 0.94rem;
        }

        @media (max-width: 1024px) {
            html, body {
                overflow: auto;
            }

            .shell {
                height: auto;
                padding: 0.8rem;
            }

            .layout {
                grid-template-columns: 1fr;
                gap: 0.8rem;
                height: auto;
            }

            .sidebar {
                position: sticky;
                top: 0.6rem;
                z-index: 2;
            }

            .nav-col {
                display: grid;
                grid-auto-flow: column;
                grid-auto-columns: minmax(170px, 1fr);
                gap: 0.45rem;
                overflow-x: auto;
                padding-bottom: 0.2rem;
                flex: none;
            }

            .nav-btn { min-height: 44px; }
            .sidebar-footer {
                margin-top: 0.4rem;
                flex-direction: row;
                gap: 0.45rem;
            }
        }

        @media (max-width: 820px) {
            .shell {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
                padding-top: calc(0.85rem + env(safe-area-inset-top, 0px));
                padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            }

            .content {
                padding: 0.85rem;
            }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, textarea { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="shell">
        <div class="layout">
            <aside class="sidebar">
                <div class="brand">
                    <img src="resources/logo.png" alt="GIIS Robotics Logo">
                    <div>
                        <h1 class="brand-title">ATLAS</h1>
                        <p class="welcome">Welcome <%= teamName %></p>
                    </div>
                </div>

                <div class="nav-col">
                    <button class="nav-btn is-active" data-tab="overview">Overview</button>
                    <button class="nav-btn" data-tab="submit">Submit Project</button>
                    <button class="nav-btn" data-tab="courses">Courses</button>
                </div>

                <div class="sidebar-footer">
                    <% if (isAdmin) { %>
                        <a class="mc-link" href="/admin">Admin Panel</a>
                    <% } %>
                    <a class="mc-danger" href="/logout">Logout</a>
                </div>
            </aside>

            <main class="content">
            <section id="panel-overview" class="tab-panel is-active">
                <h2 class="section-title">Event Timeline</h2>
                <h3 class="day-header">Day 1 - March 30</h3>
                <div class="timeline">
                    <div class="timeline-item"><div class="timeline-time">8:30 AM - 9:00 AM</div><div class="timeline-title">Registration</div><div class="timeline-desc">Teams arrive and check in.</div></div>
                    <div class="timeline-item"><div class="timeline-time">9:00 AM - 9:40 AM</div><div class="timeline-title">Opening Ceremony</div><div class="timeline-desc">Theme introduction and briefing.</div></div>
                    <div class="timeline-item"><div class="timeline-time">9:40 AM - 11:00 AM</div><div class="timeline-title">Workshop Session 1</div><div class="timeline-desc">Core concept workshop.</div></div>
                    <div class="timeline-item"><div class="timeline-time">11:15 AM - 1:00 PM</div><div class="timeline-title">Workshop Session 2</div><div class="timeline-desc">Specialized tracks.</div></div>
                    <div class="timeline-item"><div class="timeline-time">2:50 PM - 6:30 PM</div><div class="timeline-title">Build Sessions</div><div class="timeline-desc">Hands-on build and prototype.</div></div>
                </div>

                <h3 class="day-header">Day 2 - March 31</h3>
                <div class="timeline">
                    <div class="timeline-item"><div class="timeline-time">9:00 AM - 4:00 PM</div><div class="timeline-title">Final Build</div><div class="timeline-desc">Complete and polish your project.</div></div>
                    <div class="timeline-item"><div class="timeline-time">4:00 PM - 5:30 PM</div><div class="timeline-title">Judging Session</div><div class="timeline-desc">Present to judges and tech team.</div></div>
                    <div class="timeline-item"><div class="timeline-time">5:45 PM - 6:30 PM</div><div class="timeline-title">Awards Ceremony</div><div class="timeline-desc">Awards and closing celebration.</div></div>
                </div>

                <h2 class="section-title" style="margin-top:1.4rem;">Your Submissions</h2>
                <% if (submissions.length === 0) { %>
                    <div class="status-box">No submissions yet. Use Submit Project to add one.</div>
                <% } %>
                <div class="submission-list">
                    <% submissions.forEach((item) => { %>
                        <div class="submission-item">
                            <strong><%= item.project_name || 'Untitled Project' %></strong><br>
                            GitHub: <%= item.github_repository || 'N/A' %>
                        </div>
                    <% }) %>
                </div>
            </section>

            <section id="panel-submit" class="tab-panel">
                <h2 class="section-title">Submit Projects</h2>
                <% if (typeof query !== 'undefined' && query.submit === 'success') { %>
                    <div class="status-box status-box--ok">Project submitted successfully.</div>
                <% } %>
                <% if (typeof query !== 'undefined' && query.submit === 'error') { %>
                    <div class="status-box status-box--err">Project submission failed. Try again.</div>
                <% } %>
                <% if (typeof query !== 'undefined' && query.submit === 'missing') { %>
                    <div class="status-box status-box--err">Please fill all required fields.</div>
                <% } %>
                <form method="POST" action="/dashboard/projects" class="form-grid">
                    <div>
                        <label class="label" for="projectName">Project Name</label>
                        <input class="input" id="projectName" name="projectName" placeholder="Enter your project name..." required>
                    </div>
                    <div>
                        <label class="label" for="githubRepository">GitHub Repository</label>
                        <input class="input" id="githubRepository" name="githubRepository" type="url" placeholder="https://github.com/username/repo..." required>
                        <span class="small-text">Enter the full URL to your GitHub repository</span>
                    </div>
                    <div>
                        <label class="label" for="pitchDeckLink">Pitch Deck Link (Google Drive/Canva)</label>
                        <input class="input" id="pitchDeckLink" name="pitchDeckLink" type="url" placeholder="https://docs.google.com/presentation/..." required>
                        <span class="small-text">Make sure link sharing is enabled.</span>
                    </div>
                    <div>
                        <label class="label" for="projectDescription">Project Description</label>
                        <textarea class="textarea" id="projectDescription" name="projectDescription" placeholder="Describe your project..." required></textarea>
                    </div>
                    <div>
                        <button class="nav-btn" type="submit">Submit Project</button>
                    </div>
                </form>
            </section>

            <section id="panel-courses" class="tab-panel">
                <h2 class="section-title">Courses</h2>
                <% if (typeof query !== 'undefined' && query.course === 'not-found') { %>
                    <div class="status-box status-box--err">Selected article was not found.</div>
                <% } %>
                <% if (typeof query !== 'undefined' && query.course === 'error') { %>
                    <div class="status-box status-box--err">Could not load article. Please retry.</div>
                <% } %>
                <% if (courses.length === 0) { %>
                    <div class="status-box">No courses found in the projects table.</div>
                <% } %>
                <div class="courses-grid">
                    <% courses.forEach((course) => { 
                        const courseName = course.name || course.project_name || course.title || 'Untitled Course';
                        const courseDesc = course.description || course.project_description || 'No description available.';
                        const courseId = course.id;
                    %>
                        <article class="course-card">
                            <h3 class="course-name"><%= courseName %></h3>
                            <p class="course-desc"><%= courseDesc %></p>
                            <% if (courseId) { %>
                                <a class="course-link" href="/dashboard/course/<%= courseId %>">Open Article</a>
                            <% } else { %>
                                <span class="status-box status-box--err" style="margin:0;">Course id missing, cannot open article.</span>
                            <% } %>
                        </article>
                    <% }) %>
                </div>
            </section>
            </main>
        </div>
    </div>

    <script>
        const tabButtons = document.querySelectorAll('.nav-btn[data-tab]');
        const tabPanels = {
            overview: document.getElementById('panel-overview'),
            submit: document.getElementById('panel-submit'),
            courses: document.getElementById('panel-courses')
        };

        function activateTab(tab) {
            tabButtons.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.tab === tab));
            Object.entries(tabPanels).forEach(([key, panel]) => {
                panel.classList.toggle('is-active', key === tab);
            });
        }

        tabButtons.forEach((button) => {
            button.addEventListener('click', () => activateTab(button.dataset.tab));
        });

        const currentQuery = new URLSearchParams(window.location.search);
        if (currentQuery.get('submit')) {
            activateTab('submit');
        }
        if (currentQuery.get('course')) {
            activateTab('courses');
        }
    </script>
</body>
</html>
