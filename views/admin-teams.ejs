<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Teams | Atlas Admin</title>
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background: radial-gradient(ellipse at top, #0f1725 0%, #05070d 55%, #000000 100%);
            color: #DDD;
        }

        a, button, input, textarea, select { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        .page {
            width: 100%;
            max-width: 1250px;
            margin: 0 auto;
            padding: 1rem;
        }

        .card {
            border: 2px solid #1f2937;
            background: linear-gradient(145deg, rgba(20, 24, 34, 0.86), rgba(4, 6, 10, 0.9));
            box-shadow: inset -2px -4px rgba(0, 0, 0, 0.45), inset 2px 2px rgba(255, 255, 255, 0.08);
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 10px;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            font-size: clamp(18px, 2.6vw, 30px);
        }

        .subtitle {
            margin: 0.2rem 0 0;
            font-family: 'mc7', monospace;
            color: #90EE90;
            font-size: 0.82rem;
        }

        .btn {
            border: 2px solid #000;
            background: #2f3e56 url('/resources/bgbtn.png') center / cover;
            color: #DDD;
            text-decoration: none;
            font-family: 'mc7', monospace;
            text-shadow: 2px 2px #000A;
            padding: 0.7rem 0.85rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            transition: border-color 0.15s ease, filter 0.15s ease;
        }

        .btn:hover,
        .btn:focus-visible {
            border-color: #FFFFA0;
            filter: brightness(1.08);
            outline: none;
        }

        .status {
            border: 2px solid #1f2937;
            background: rgba(0, 0, 0, 0.35);
            padding: 0.7rem 0.8rem;
            font-family: 'mc7', monospace;
            font-size: 0.74rem;
            margin-bottom: 0.8rem;
            border-radius: 6px;
        }

        .status.ok { color: #90EE90; }
        .status.err { color: #ff8c8c; }

        .label {
            display: block;
            margin-bottom: 0.35rem;
            font-family: 'mc7', monospace;
            font-size: 0.86rem;
            color: #DDD;
        }

        .section-title {
            margin: 0 0 0.85rem;
            font-family: 'mc7', monospace;
            color: #9ad3ff;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .input,
        .textarea,
        .select {
            width: 100%;
            border: 2px solid #111827;
            background: #1b2432;
            color: #FFF;
            font-family: 'mc7', monospace;
            padding: 0.65rem 0.75rem;
            font-size: 0.8rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #ffffff22;
            margin-bottom: 0.8rem;
            border-radius: 6px;
        }

        .textarea { min-height: 95px; resize: vertical; }

        .split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.7rem;
        }

        .layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            align-items: start;
        }

        .stack {
            display: grid;
            gap: 1rem;
        }

        details {
            border: 1px solid #334155;
            border-radius: 8px;
            background: rgba(4, 8, 15, 0.45);
            padding: 0.5rem 0.7rem;
            margin-bottom: 0.8rem;
        }

        summary {
            font-family: 'mc7', monospace;
            color: #ffd58a;
            font-size: 0.75rem;
            user-select: none;
            outline: none;
        }

        .team-list {
            border: 2px solid #1f2937;
            background: rgba(0, 0, 0, 0.35);
            border-radius: 8px;
            padding: 0.75rem;
            font-family: 'mc7', monospace;
            font-size: 0.7rem;
            max-height: 350px;
            overflow: auto;
        }

        .team-item {
            margin-bottom: 0.6rem;
            padding: 0.55rem;
            border: 1px solid #2b3444;
            border-radius: 6px;
            background: rgba(12, 18, 28, 0.55);
            color: #DDD;
        }

        .team-item strong { color: #FFFFA0; }

        .meta { color: #9ab; }

        .hint {
            margin-top: -0.15rem;
            margin-bottom: 0.8rem;
            color: #AAA;
            font-family: 'mc7', monospace;
            font-size: 0.68rem;
        }

        .toolbar-row {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 0.7rem;
        }

        .pill {
            border: 1px solid #334155;
            border-radius: 999px;
            padding: 0.28rem 0.62rem;
            font-family: 'mc7', monospace;
            font-size: 0.62rem;
            color: #b8d7ff;
            background: rgba(7, 13, 23, 0.65);
        }

        @media (max-width: 820px) {
            .page {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
                padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
                padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            }

            .btn { width: 100%; }
            .split { grid-template-columns: 1fr; }
            .layout { grid-template-columns: 1fr; }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, textarea, select { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="card top">
            <div>
                <h1 class="title">TEAM ACCOUNTS</h1>
                <p class="subtitle"><%= user.email %></p>
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a class="btn" href="/admin">← Back to Admin</a>
                <a class="btn" href="/logout">Logout</a>
            </div>
        </section>

        <div class="layout">
            <div class="stack">
                <section class="card">
                    <h2 class="section-title">Create Team Account</h2>
                    <div class="status" id="createStatus">Creates teamname@giisrobotics.club, generates password, and sends credentials.</div>
                    <% if (!hasServiceRole) { %>
                        <div class="status err">SUPABASE_SERVICE_ROLE_KEY is missing. Team account creation is disabled.</div>
                    <% } %>

                    <form method="POST" action="/admin/create-team">
                        <label class="label" for="teamName">Team Name</label>
                        <input class="input" id="teamName" name="teamName" placeholder="Team Phoenix" required>

                        <label class="label" for="recipients">Recipients (comma-separated emails)</label>
                        <textarea class="textarea" id="recipients" name="recipients" placeholder="member1@example.com, member2@example.com"></textarea>
                        <p class="hint">Leave recipients empty to send only to generated team email.</p>

                        <details>
                            <summary>Advanced: Edit Email Template (Rare)</summary>
                            <div style="margin-top:0.6rem;">
                                <label class="label" for="emailSubject">One-Time Subject Override</label>
                                <input class="input" id="emailSubject" name="emailSubject" value="<%= defaultTeamMailTemplates.subject %>">

                                <label class="label" for="emailBody">One-Time Body Override</label>
                                <textarea class="textarea" id="emailBody" name="emailBody"><%= defaultTeamMailTemplates.body %></textarea>
                                <p class="hint">Supported placeholders: {{TEAM_NAME}}, {{TEAM_EMAIL}}, {{PASSWORD}}, {{LOGIN_URL}}</p>
                            </div>
                        </details>

                        <button class="btn" type="submit" <%= hasServiceRole ? '' : 'disabled' %>>Create Team Account</button>
                    </form>
                </section>

            </div>

            <div class="stack">
                <section class="card">
                    <h2 class="section-title">Add Members To Team</h2>
                    <div class="status" id="memberStatus">Saves to table: <strong><%= teamMembersTable %></strong>.</div>

                    <form method="POST" action="/admin/teams/members">
                        <label class="label" for="teamId">Select Team</label>
                        <select class="select" id="teamId" name="teamId" required>
                            <option value="">Choose a team...</option>
                            <% teams.forEach((team) => { %>
                                <option value="<%= team.teamId %>"><%= team.teamName %> (<%= team.teamEmail || 'no email' %>)</option>
                            <% }) %>
                        </select>

                        <label class="label" for="members">Member Names</label>
                        <textarea class="textarea" id="members" name="members" placeholder="One per line or comma-separated&#10;Aarav Shah&#10;Mira Nair" required></textarea>

                        <div class="split">
                            <div>
                                <label class="label" for="className">Class</label>
                                <input class="input" id="className" name="className" placeholder="Grade 8">
                            </div>
                            <div>
                                <label class="label" for="section">Section</label>
                                <input class="input" id="section" name="section" placeholder="A">
                            </div>
                        </div>

                        <label class="label" for="allegiance">Allegiance</label>
                        <input class="input" id="allegiance" name="allegiance" placeholder="Red / Blue / House Name">

                        <button class="btn" type="submit">Add Members</button>
                    </form>
                </section>

                <section class="card">
                    <h2 class="section-title">Saved Email Template</h2>
                    <div class="status" id="templateStatus">Rarely edited. Save once and reuse for all team account emails.</div>
                    <form method="POST" action="/admin/teams/email-template">
                        <label class="label" for="savedEmailSubject">Subject</label>
                        <input class="input" id="savedEmailSubject" name="emailSubject" value="<%= defaultTeamMailTemplates.subject %>" required>

                        <label class="label" for="savedEmailBody">Body</label>
                        <textarea class="textarea" id="savedEmailBody" name="emailBody" required><%= defaultTeamMailTemplates.body %></textarea>
                        <p class="hint">Placeholders: {{TEAM_NAME}}, {{TEAM_EMAIL}}, {{PASSWORD}}, {{LOGIN_URL}}</p>

                        <button class="btn" type="submit">Save Template Permanently</button>
                    </form>
                </section>

                <section class="card">
                    <div class="toolbar-row">
                        <h2 class="section-title" style="margin:0;">Existing Teams</h2>
                        <span class="pill"><%= teams.length %> Teams</span>
                    </div>
                    <input id="teamSearch" class="input" placeholder="Search by team name or email..." style="margin-bottom:0.65rem;">
                    <div class="team-list" id="teamList">
                        <% if (!teams.length) { %>
                            <div class="team-item">No teams found in teams table.</div>
                        <% } %>
                        <% teams.forEach((team) => { %>
                            <div class="team-item" data-team-item="true" data-search="<%= (team.teamName + ' ' + (team.teamEmail || '')).toLowerCase() %>">
                                <strong><%= team.teamName %></strong><br>
                                <span class="meta">Team ID: <%= team.teamId %></span><br>
                                <span class="meta">Email: <%= team.teamEmail || 'N/A' %></span>
                            </div>
                        <% }) %>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        const query = new URLSearchParams(window.location.search);
        const status = document.getElementById('createStatus');
        const memberStatus = document.getElementById('memberStatus');
        const templateStatus = document.getElementById('templateStatus');
        const create = query.get('create');
        const member = query.get('member');
        const template = query.get('template');

        const teamSearch = document.getElementById('teamSearch');
        const teamItems = Array.from(document.querySelectorAll('[data-team-item="true"]'));

        if (teamSearch) {
            teamSearch.addEventListener('input', () => {
                const q = String(teamSearch.value || '').trim().toLowerCase();
                teamItems.forEach((item) => {
                    const text = item.getAttribute('data-search') || '';
                    item.style.display = !q || text.includes(q) ? '' : 'none';
                });
            });
        }

        if (create === 'success') {
            status.classList.add('ok');
            status.textContent = 'Team account created and credentials email sent.';
        } else if (create === 'service-key-missing') {
            status.classList.add('err');
            status.textContent = 'SUPABASE_SERVICE_ROLE_KEY is required to create team accounts.';
        } else if (create === 'missing-team') {
            status.classList.add('err');
            status.textContent = 'Team name is required.';
        } else if (create === 'invalid-team') {
            status.classList.add('err');
            status.textContent = 'Team name is invalid for an email handle.';
        } else if (create === 'error') {
            status.classList.add('err');
            status.textContent = 'Failed to create team account or send email.';
        }

        if (template === 'saved') {
            templateStatus.classList.add('ok');
            templateStatus.textContent = 'Template saved successfully. It will be reused by default.';
        } else if (template === 'missing') {
            templateStatus.classList.add('err');
            templateStatus.textContent = 'Subject and body are required to save template.';
        } else if (template === 'table-missing') {
            templateStatus.classList.add('err');
            templateStatus.textContent = 'admin_settings table is missing. Run SQL setup update.';
        } else if (template === 'error') {
            templateStatus.classList.add('err');
            templateStatus.textContent = 'Failed to save template.';
        }

        if (member === 'added') {
            memberStatus.classList.add('ok');
            memberStatus.textContent = 'Members added/updated successfully.';
        } else if (member === 'missing') {
            memberStatus.classList.add('err');
            memberStatus.textContent = 'Please select team and enter at least one member name.';
        } else if (member === 'team-not-found') {
            memberStatus.classList.add('err');
            memberStatus.textContent = 'Selected team was not found. Refresh and try again.';
        } else if (member === 'table-missing') {
            memberStatus.classList.add('err');
            memberStatus.textContent = 'team_members table is missing. Run the SQL setup first.';
        } else if (member === 'error') {
            memberStatus.classList.add('err');
            memberStatus.textContent = 'Failed to add members. Check server logs for details.';
        }
    </script>
</body>
</html>
