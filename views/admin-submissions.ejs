<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Submissions | Atlas Admin</title>
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background-image: url('/resources/background.jpg');
            background-size: cover;
            background-position: center center;
            color: #DDD;
        }

        a, button { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        .page {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem;
        }

        .card {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20, 20, 30, 0.82), rgba(0, 0, 0, 0.82));
            box-shadow: inset -3px -6px rgba(0, 0, 0, 0.45), inset 3px 3px rgba(255, 255, 255, 0.06);
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            font-size: clamp(20px, 2.8vw, 32px);
        }

        .subtitle {
            margin: 0.2rem 0 0;
            font-family: 'mc7', monospace;
            color: #90EE90;
            font-size: 0.82rem;
        }

        .btn {
            border: 2px solid #000;
            background: #999 url('/resources/bgbtn.png') center / cover;
            color: #DDD;
            text-decoration: none;
            font-family: 'mc7', monospace;
            text-shadow: 2px 2px #000A;
            padding: 0.7rem 0.85rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            transition: border-color 0.15s ease, filter 0.15s ease;
        }

        .btn:hover,
        .btn:focus-visible {
            border-color: #FFFFA0;
            filter: brightness(1.08);
            outline: none;
        }

        .status {
            border: 2px solid #000;
            background: rgba(0, 0, 0, 0.35);
            padding: 0.75rem 0.85rem;
            font-family: 'mc7', monospace;
            font-size: 0.82rem;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            margin-top: 0.8rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 860px;
            font-family: 'mc7', monospace;
            font-size: 0.8rem;
        }

        th, td {
            border: 1px solid rgba(255,255,255,0.12);
            padding: 0.55rem 0.6rem;
            text-align: left;
            vertical-align: top;
        }

        th {
            color: #FFFFA0;
            background: rgba(0,0,0,0.35);
        }

        td { color: #DDD; }

        .table-link {
            color: #8AB8FF;
            text-decoration: underline;
            word-break: break-all;
        }

        @media (max-width: 820px) {
            .page {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
                padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
                padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            }

            .btn { width: 100%; }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="card top">
            <div>
                <h1 class="title">SUBMITTED PROJECTS</h1>
                <p class="subtitle"><%= user.email %></p>
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a class="btn" href="/admin">← Back to Admin</a>
                <a class="btn" href="/logout">Logout</a>
            </div>
        </section>

        <section class="card">
            <% if (submittedProjects.length === 0) { %>
                <div class="status">No submitted projects found yet.</div>
            <% } %>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Team</th>
                            <th>Project</th>
                            <th>GitHub</th>
                            <th>Pitch Deck</th>
                            <th>Description</th>
                            <th>Submitted</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% submittedProjects.forEach((item) => { %>
                            <tr>
                                <td><%= item.team_name || 'N/A' %></td>
                                <td><%= item.project_name || 'N/A' %></td>
                                <td>
                                    <% if (item.github_repository) { %>
                                        <a class="table-link" href="<%= item.github_repository %>" target="_blank"><%= item.github_repository %></a>
                                    <% } else { %>
                                        N/A
                                    <% } %>
                                </td>
                                <td>
                                    <% if (item.pitch_deck_link) { %>
                                        <a class="table-link" href="<%= item.pitch_deck_link %>" target="_blank"><%= item.pitch_deck_link %></a>
                                    <% } else { %>
                                        N/A
                                    <% } %>
                                </td>
                                <td><%= item.project_description || 'N/A' %></td>
                                <td><%= item.created_at ? new Date(item.created_at).toLocaleString() : 'N/A' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</body>
</html>
