<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Food and Attendance | Atlas Admin</title>
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background-image: url('/resources/background.jpg');
            background-size: cover;
            background-position: center center;
            color: #ddd;
        }

        a, button, input, select { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        .page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 1rem;
        }

        .card {
            border: 2px solid #2a2a2a;
            background: linear-gradient(145deg, rgba(20, 20, 26, 0.9), rgba(6, 6, 10, 0.9));
            box-shadow: inset -2px -4px rgba(0, 0, 0, 0.45), inset 2px 2px rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            color: #ffffa0;
            font-family: 'mc7', monospace;
            text-shadow: 2px 2px #000a;
            font-size: clamp(18px, 2.8vw, 30px);
        }

        .subtitle {
            margin: 0.25rem 0 0;
            color: #90ee90;
            font-family: 'mc7', monospace;
            font-size: 0.82rem;
        }

        .actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .btn {
            border: 2px solid #000;
            background: #444 url('/resources/bgbtn.png') center / cover;
            color: #ddd;
            text-decoration: none;
            font-family: 'mc7', monospace;
            text-shadow: 2px 2px #000a;
            padding: 0.65rem 0.85rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #fff5;
            transition: border-color 0.15s ease, filter 0.15s ease;
        }

        .btn:hover { border-color: #ffffa0; filter: brightness(1.08); }

        .status {
            border: 2px solid #2a2a2a;
            background: rgba(0, 0, 0, 0.35);
            padding: 0.7rem 0.85rem;
            font-family: 'mc7', monospace;
            font-size: 0.75rem;
            margin-bottom: 0.8rem;
            color: #ccc;
        }

        .status.ok { color: #90ee90; border-color: #2a5a2a; }
        .status.err { color: #ff9d9d; border-color: #5a2a2a; }

        .controls {
            display: grid;
            grid-template-columns: 1fr 220px 220px;
            gap: 0.7rem;
        }

        .mode-switch {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
            flex-wrap: wrap;
        }

        .mode-btn {
            border: 1px solid #425766;
            background: #111e27;
            color: #9adfff;
            font-family: 'mc7', monospace;
            font-size: 0.68rem;
            padding: 0.48rem 0.7rem;
        }

        .mode-btn.active {
            border-color: #90ee90;
            background: #1b3523;
            color: #b8ffb8;
        }

        .control-block.hidden {
            display: none;
        }

        .workspace {
            display: none;
        }

        .workspace.active {
            display: block;
        }

        .input, .select {
            width: 100%;
            border: 2px solid #000;
            background: #222;
            color: #fff;
            font-family: 'mc7', monospace;
            padding: 0.65rem 0.75rem;
            font-size: 0.8rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #fff2;
        }

        .grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1rem;
        }

        .team-list {
            display: grid;
            gap: 0.75rem;
        }

        .team-card {
            border: 2px solid #2a2a2a;
            border-radius: 6px;
            padding: 0.8rem;
            background: linear-gradient(180deg, rgba(22, 22, 28, 0.95), rgba(10, 10, 14, 0.95));
        }

        .team-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
            margin-bottom: 0.6rem;
        }

        .team-name {
            margin: 0;
            color: #ffffa0;
            font-family: 'mc7', monospace;
            font-size: 0.9rem;
        }

        .meta {
            color: #bdbdbd;
            font-family: 'mc7', monospace;
            font-size: 0.7rem;
            line-height: 1.5;
        }

        .members {
            color: #8fc4ff;
            font-family: 'mc7', monospace;
            font-size: 0.68rem;
            margin-top: 0.4rem;
        }

        .member-list {
            display: grid;
            gap: 0.55rem;
            margin-top: 0.6rem;
        }

        .member-row {
            border: 1px solid #32323b;
            background: #0d1218;
            padding: 0.55rem;
        }

        .member-name {
            color: #9adfff;
            font-family: 'mc7', monospace;
            font-size: 0.72rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.45rem;
            flex-wrap: wrap;
        }

        .member-meta {
            color: #b6b6b6;
            font-family: 'mc7', monospace;
            font-size: 0.62rem;
            margin-top: 0.3rem;
        }

        .session-grid {
            margin-top: 0.7rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.45rem;
        }

        .day-group {
            border: 1px solid #2a3844;
            background: #0b1d27;
            padding: 0.45rem;
            border-radius: 4px;
        }

        .day-title {
            color: #9adfff;
            font-family: 'mc7', monospace;
            font-size: 0.6rem;
            margin-bottom: 0.35rem;
            letter-spacing: 0.04em;
        }

        .day-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(80px, 1fr));
            gap: 0.35rem;
        }

        .session-btn {
            width: 100%;
            border: 1px solid #567;
            background: #102a35;
            color: #9adfff;
            font-family: 'mc7', monospace;
            font-size: 0.65rem;
            padding: 0.45rem;
        }

        .session-btn:hover { border-color: #9adfff; }

        .session-btn.collected {
            background: #2f2f2f;
            border-color: #666;
            color: #9a9a9a;
        }

        .session-btn.collected::after {
            content: '  done';
            color: #bbb;
        }

        .sidebar-title {
            margin: 0 0 0.7rem;
            color: #ffffa0;
            font-family: 'mc7', monospace;
            font-size: 0.85rem;
        }

        .sheet-list {
            max-height: 340px;
            overflow: auto;
            border: 1px solid #333;
            padding: 0.55rem;
            background: #0c0c11;
            margin-bottom: 0.7rem;
        }

        .check-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.45rem;
            font-family: 'mc7', monospace;
            font-size: 0.68rem;
        }

        .small-btn {
            width: 100%;
            border: 1px solid #397339;
            background: #163016;
            color: #9dff9d;
            font-family: 'mc7', monospace;
            font-size: 0.7rem;
            padding: 0.5rem;
            margin-bottom: 0.45rem;
        }

        .hint {
            color: #b0b0b0;
            font-family: 'mc7', monospace;
            font-size: 0.65rem;
            line-height: 1.5;
        }

        @media (max-width: 980px) {
            .controls { grid-template-columns: 1fr; }
            .grid { grid-template-columns: 1fr; }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, select { cursor: auto; }
        }
    </style>
</head>
<body>
<div class="page">
    <section class="card top">
        <div>
            <h1 class="title">FOOD AND ATTENDANCE OPS</h1>
            <p class="subtitle"><%= user.email %></p>
        </div>
        <div class="actions">
            <a class="btn" href="/admin">Back to Admin</a>
            <a class="btn" href="/logout">Logout</a>
        </div>
    </section>

    <section class="card">
        <div id="status" class="status">Search by team name or any team member name.</div>
        <div class="mode-switch">
            <button id="foodModeBtn" class="mode-btn active" type="button">Food Ops View</button>
            <button id="attendanceModeBtn" class="mode-btn" type="button">Attendance View</button>
        </div>
        <div class="controls">
            <input id="searchInput" class="input" placeholder="Type team name or member name..." />
            <div id="attendanceSessionWrap" class="control-block hidden">
                <select id="attendanceSession" class="select">
                    <% attendanceSessions.forEach((session) => { %>
                        <option value="<%= session.id %>"><%= session.label %></option>
                    <% }) %>
                </select>
            </div>
            <button id="searchBtn" class="btn" type="button">Search</button>
        </div>
    </section>

    <section id="foodWorkspace" class="workspace active">
        <div class="card">
            <h2 class="sidebar-title">Food Collection Queue</h2>
            <p class="hint">Member cards below are focused only on food collection actions.</p>
            <div id="teamList" class="team-list"></div>
        </div>
    </section>

    <section id="attendanceWorkspace" class="workspace">
        <div class="grid">
            <div class="card">
                <h2 class="sidebar-title">Manual Attendance Sheet</h2>
                <p class="hint">Choose session, tick members, then confirm once.</p>
                <div class="sheet-list" id="sheetList"></div>
                <button id="markManualBtn" class="small-btn" type="button">Mark Selected Present (Confirm)</button>
            </div>

            <div class="card">
                <h2 class="sidebar-title">Attendance Notes</h2>
                <p class="hint">This view is attendance-only to avoid mixing food controls while marking presence.</p>
                <p class="hint">Food actions and manual attendance ask for confirmation to prevent accidental taps.</p>
                <p class="hint">Members table: <strong><%= teamMembersTable %></strong></p>
                <p class="hint">Member operations table: <strong><%= memberOperationsTable %></strong></p>
            </div>
        </div>
    </section>
</div>

<script>
    const foodSessions = [
        { id: 'day1_lunch', label: 'Day 1 Lunch' },
        { id: 'day1_snack', label: 'Day 1 Snack' },
        { id: 'day2_lunch', label: 'Day 2 Lunch' },
        { id: 'day2_snack', label: 'Day 2 Snack' }
    ];

    const statusEl = document.getElementById('status');
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const foodModeBtn = document.getElementById('foodModeBtn');
    const attendanceModeBtn = document.getElementById('attendanceModeBtn');
    const foodWorkspace = document.getElementById('foodWorkspace');
    const attendanceWorkspace = document.getElementById('attendanceWorkspace');
    const attendanceSessionWrap = document.getElementById('attendanceSessionWrap');
    const teamList = document.getElementById('teamList');
    const sheetList = document.getElementById('sheetList');
    const attendanceSession = document.getElementById('attendanceSession');
    const markManualBtn = document.getElementById('markManualBtn');

    let teams = [];
    let activeMode = 'food';

    function setStatus(message, type = '') {
        statusEl.className = 'status';
        if (type) {
            statusEl.classList.add(type);
        }
        statusEl.textContent = message;
    }

    function setMode(mode) {
        activeMode = mode === 'attendance' ? 'attendance' : 'food';

        const isAttendance = activeMode === 'attendance';
        foodModeBtn.classList.toggle('active', !isAttendance);
        attendanceModeBtn.classList.toggle('active', isAttendance);
        foodWorkspace.classList.toggle('active', !isAttendance);
        attendanceWorkspace.classList.toggle('active', isAttendance);
        attendanceSessionWrap.classList.toggle('hidden', !isAttendance);

        if (isAttendance) {
            renderSheet();
            setStatus('Attendance view active. Select session and mark present members.');
        } else {
            setStatus('Food Ops view active. Search and mark collected sessions.');
        }
    }

    function escapeHtml(value) {
        return String(value || '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function toTitle(value) {
        return String(value || '')
            .replaceAll('_', ' ')
            .replace(/\b\w/g, (char) => char.toUpperCase());
    }

    function buildFoodGroups(member) {
        const grouped = new Map();
        const fallbackButtons = [];

        foodSessions.forEach((session) => {
            const collected = Boolean(member.food?.[session.id]);
            const button = '<button class="session-btn ' + (collected ? 'collected' : '') + '" data-member-id="' + escapeHtml(member.memberId) + '" data-session-id="' + escapeHtml(session.id) + '" ' + (collected ? 'disabled' : '') + '>' + escapeHtml(toTitle(session.id.split('_').slice(1).join('_') || session.label)) + '</button>';
            const match = /^day(\d+)_(.+)$/.exec(session.id);

            if (!match) {
                fallbackButtons.push(button);
                return;
            }

            const day = Number(match[1]);
            if (!grouped.has(day)) {
                grouped.set(day, []);
            }
            grouped.get(day).push(button);
        });

        const dayBlocks = Array.from(grouped.keys())
            .sort((a, b) => a - b)
            .map((day) => '<div class="day-group"><div class="day-title">DAY ' + day + '</div><div class="day-actions">' + grouped.get(day).join('') + '</div></div>');

        if (fallbackButtons.length) {
            dayBlocks.push('<div class="day-group"><div class="day-title">OTHER</div><div class="day-actions">' + fallbackButtons.join('') + '</div></div>');
        }

        return dayBlocks.join('');
    }

    async function searchTeams() {
        const q = searchInput.value.trim();
        setStatus('Searching teams...');

        try {
            const resp = await fetch('/api/admin/operations/search?q=' + encodeURIComponent(q));
            const data = await resp.json();

            if (!resp.ok || !data.success) {
                throw new Error(data.message || 'Search failed');
            }

            teams = data.teams || [];
            renderTeams();
            renderSheet();

            if (data.tableMissing) {
                setStatus('Search worked, but operations table is missing. Create table before marking food or attendance.', 'err');
            } else {
                setStatus('Found ' + teams.length + ' team(s).');
            }
        } catch (error) {
            setStatus(error.message || 'Search failed.', 'err');
            teamList.innerHTML = '';
            sheetList.innerHTML = '';
        }
    }

    function renderTeams() {
        if (!teams.length) {
            teamList.innerHTML = '<div class="hint">No teams matched your search.</div>';
            return;
        }

        teamList.innerHTML = teams.map((team) => {
            const memberRows = (team.members || []).map((member) => {
                const foodButtons = buildFoodGroups(member);

                return '<div class="member-row">'
                    + '<div class="member-name">'
                    + '<span>' + escapeHtml(member.memberName) + '</span>'
                    + '</div>'
                    + '<div class="member-meta">Allegiance: ' + escapeHtml(member.allegiance || '-') + '</div>'
                    + '<div class="session-grid">' + foodButtons + '</div>'
                    + '</div>';
            }).join('');

            return '<article class="team-card" data-team-id="' + escapeHtml(team.teamId) + '">'
                + '<div class="team-head">'
                + '<h3 class="team-name">' + escapeHtml(team.teamName) + '</h3>'
                + '</div>'
                + '<div class="meta">Allegiance: ' + escapeHtml(team.allegiance || '-') + '<br>Email: ' + escapeHtml(team.teamEmail || '-') + '</div>'
                + '<div class="members">Total Members: ' + escapeHtml((team.members || []).length) + '</div>'
                + '<div class="member-list">' + memberRows + '</div>'
                + '</article>';
        }).join('');
    }

    function renderSheet() {
        if (!teams.length) {
            sheetList.innerHTML = '<div class="hint">Search first to build the attendance sheet list.</div>';
            return;
        }

        const rows = [];

        teams.forEach((team) => {
            (team.members || []).forEach((member) => {
                const checked = Boolean(member.attendance?.[attendanceSession.value]) ? 'checked' : '';
                rows.push('<label class="check-row">'
                    + '<input type="checkbox" value="' + escapeHtml(member.memberId) + '" ' + checked + '>'
                    + '<span>' + escapeHtml(team.teamName) + ' - ' + escapeHtml(member.memberName) + '</span>'
                    + '</label>');
            });
        });

        sheetList.innerHTML = rows.join('') || '<div class="hint">No members available.</div>';
    }

    async function markFood(memberId, sessionId) {
        let teamName = 'Team';
        let memberName = 'Member';

        for (const team of teams) {
            const found = (team.members || []).find((member) => member.memberId === memberId);
            if (found) {
                teamName = team.teamName || teamName;
                memberName = found.memberName || memberName;
                break;
            }
        }

        const sessionLabel = foodSessions.find((session) => session.id === sessionId)?.label || toTitle(sessionId);
        const shouldContinue = window.confirm('Mark ' + sessionLabel + ' as collected for ' + memberName + ' (' + teamName + ')?');
        if (!shouldContinue) {
            setStatus('Food update cancelled.');
            return;
        }

        setStatus('Updating food collection...');

        try {
            const resp = await fetch('/api/admin/operations/food', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ memberId, sessionId })
            });

            const data = await resp.json();
            if (!resp.ok || !data.success) {
                throw new Error(data.message || 'Failed to mark collection');
            }

            teams = teams.map((team) => ({
                ...team,
                members: (team.members || []).map((member) => member.memberId === memberId ? data.member : member)
            }));
            renderTeams();
            renderSheet();

            if (data.alreadyCollected) {
                setStatus('Already collected earlier. Kept visible and greyed out.', 'ok');
            } else {
                setStatus('Food marked successfully.', 'ok');
            }
        } catch (error) {
            setStatus(error.message || 'Could not mark food.', 'err');
        }
    }

    async function markManualAttendance() {
        const checked = Array.from(sheetList.querySelectorAll('input[type="checkbox"]:checked')).map((node) => node.value);

        if (!checked.length) {
            setStatus('Select at least one member in the attendance sheet.', 'err');
            return;
        }

        const selectedAttendance = attendanceSession.options[attendanceSession.selectedIndex]?.text || toTitle(attendanceSession.value);
        const shouldContinue = window.confirm('Mark ' + checked.length + ' selected member(s) present for ' + selectedAttendance + '?');
        if (!shouldContinue) {
            setStatus('Attendance update cancelled.');
            return;
        }

        setStatus('Updating attendance...');

        try {
            const resp = await fetch('/api/admin/operations/attendance/manual', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: attendanceSession.value, memberIds: checked })
            });

            const data = await resp.json();
            if (!resp.ok || !data.success) {
                throw new Error(data.message || 'Failed to mark attendance');
            }

            teams = teams.map((team) => ({
                ...team,
                members: (team.members || []).map((member) => ({
                    ...member,
                    attendance: {
                        ...member.attendance,
                        [attendanceSession.value]: checked.includes(member.memberId) ? true : Boolean(member.attendance?.[attendanceSession.value])
                    }
                }))
            }));

            renderSheet();
            setStatus('Manual attendance updated for ' + data.updated + ' team(s).', 'ok');
        } catch (error) {
            setStatus(error.message || 'Could not update attendance.', 'err');
        }
    }

    searchBtn.addEventListener('click', searchTeams);
    foodModeBtn.addEventListener('click', () => setMode('food'));
    attendanceModeBtn.addEventListener('click', () => setMode('attendance'));
    searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            searchTeams();
        }
    });

    attendanceSession.addEventListener('change', () => {
        renderSheet();
    });

    markManualBtn.addEventListener('click', markManualAttendance);

    teamList.addEventListener('click', (event) => {
        const foodBtn = event.target.closest('.session-btn');
        if (foodBtn) {
            markFood(foodBtn.getAttribute('data-member-id'), foodBtn.getAttribute('data-session-id'));
        }
    });

    setMode('food');
    searchTeams();
</script>
</body>
</html>
