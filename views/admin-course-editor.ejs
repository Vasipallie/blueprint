<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Course Editor | Atlas Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css">
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            font-size: clamp(16px, 2.1vw, 20px);
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background-image: url('/resources/background.jpg');
            background-size: cover;
            background-position: center center;
            color: #DDD;
        }

        a, button, input, textarea, select { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        .page {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem;
            display: grid;
            grid-template-columns: 330px 1fr;
            gap: 1rem;
        }

        .sidebar,
        .content {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20,20,30,0.82), rgba(0,0,0,0.82));
            box-shadow: inset -3px -6px rgba(0,0,0,0.45), inset 3px 3px rgba(255,255,255,0.06);
        }

        .sidebar {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .content { padding: 1rem; }

        .brand {
            display: flex;
            gap: 0.65rem;
            align-items: center;
        }

        .brand img { width: 62px; height: auto; }

        .brand-title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            font-size: clamp(20px, 2vw, 28px);
            text-shadow: 2px 2px #000A;
        }

        .subtitle {
            margin: 0.2rem 0 0;
            font-family: 'mc7', monospace;
            color: #90EE90;
            font-size: 0.82rem;
        }

        .section-title {
            margin: 0 0 0.9rem;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            text-shadow: 2px 2px #000A;
            font-size: clamp(20px, 2.6vw, 32px);
        }

        .status-box {
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            padding: 0.75rem 0.85rem;
            margin-bottom: 0.9rem;
            font-family: 'mc7', monospace;
            font-size: 0.82rem;
            color: #DDD;
        }

        .status-box--ok { color: #90EE90; }
        .status-box--err { color: #ff8c8c; }

        .label {
            display: block;
            font-family: 'mc7', monospace;
            color: #DDD;
            font-size: 0.86rem;
            margin-bottom: 0.35rem;
        }

        .input,
        .textarea,
        .select {
            width: 100%;
            border: 2px solid #000;
            background: #333 url('/resources/bgbtn.png') center / cover;
            color: #FFF;
            font-family: 'mc7', monospace;
            padding: 0.65rem 0.75rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF3;
            font-size: 0.88rem;
        }

        .textarea { min-height: 110px; resize: vertical; }

        .btn,
        .link-btn {
            border: 2px solid #000;
            background: #999 url('/resources/bgbtn.png') center / cover;
            color: #DDD;
            font-family: 'mc7', monospace;
            font-size: 0.9rem;
            text-shadow: 2px 2px #000A;
            padding: 0.7rem 0.85rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
        }

        .btn-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 0.8rem;
        }

        .courses-list {
            display: grid;
            gap: 0.5rem;
            margin-top: 0.4rem;
            max-height: 60vh;
            overflow: auto;
            padding-right: 0.2rem;
        }

        .course-item {
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            padding: 0.65rem 0.7rem;
            font-family: 'mc7', monospace;
        }

        .course-item h4 {
            margin: 0 0 0.35rem;
            font-size: 0.88rem;
            color: #FFFFA0;
        }

        .course-item p {
            margin: 0 0 0.5rem;
            font-size: 0.76rem;
            color: #CCC;
            line-height: 1.45;
        }

        .summernote-shell {
            border: 2px solid #000;
            box-shadow: inset -2px -3px #0005, inset 2px 2px #FFF2;
            background: #fff;
        }

        .note-editor.note-frame {
            border: 0;
        }

        .note-toolbar {
            background: #eef2f6;
        }

        .btn:hover,
        .link-btn:hover,
        .btn:focus-visible,
        .link-btn:focus-visible {
            border-color: #FFFFA0;
            filter: brightness(1.08);
            outline: none;
        }

        @media (max-width: 1080px) {
            .page {
                grid-template-columns: 1fr;
                padding: 0.8rem;
            }
        }

        @media (max-width: 820px) {
            .page {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
                padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
                padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, textarea, select { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <aside class="sidebar">
            <div class="brand">
                <img src="/resources/logo.png" alt="GIIS Robotics Logo">
                <div>
                    <h1 class="brand-title">COURSE EDITOR</h1>
                    <p class="subtitle"><%= user.email %></p>
                </div>
            </div>

            <a class="link-btn" href="/admin">← Back to Admin Panel</a>
            <a class="link-btn" href="/logout">Logout</a>

            <h3 class="label" style="margin-top:0.6rem;">Existing Courses</h3>
            <div class="courses-list" id="coursesList">
                <% courses.forEach((course) => { %>
                    <article class="course-item">
                        <h4><%= course.name || 'Untitled' %></h4>
                        <p><%= course.description || 'No description' %></p>
                        <button
                            class="btn"
                            type="button"
                            data-load-course="true"
                            data-course-id="<%= course.id %>"
                            data-course-name="<%= encodeURIComponent(course.name || '') %>"
                            data-course-description="<%= encodeURIComponent(course.description || '') %>"
                            data-course-html="<%= encodeURIComponent(course.html_content || '') %>"
                        >Edit</button>
                    </article>
                <% }) %>
            </div>
        </aside>

        <main class="content">
            <h2 class="section-title">Create or Edit Course</h2>

            <div class="status-box" id="saveStatus">Only admins can edit and publish HTML course articles.</div>

            <form method="POST" action="/admin/courses" id="courseForm">
                <input type="hidden" id="courseId" name="courseId">

                <label class="label" for="courseName">Course Name</label>
                <input id="courseName" name="name" class="input" placeholder="Intro to Robotics" required>

                <label class="label" for="courseDescription">Short Description</label>
                <textarea id="courseDescription" name="description" class="textarea" placeholder="What this course teaches..." required></textarea>

                <label class="label">Article Content (HTML Rich Text)</label>
                <div class="summernote-shell">
                    <textarea id="htmlEditor" name="htmlContent"><p></p></textarea>
                </div>

                <div class="btn-row">
                    <button class="btn" type="submit" id="saveBtn">Save Course</button>
                    <button class="btn" type="button" id="newBtn">New Course</button>
                    <button class="btn" type="button" id="deleteBtn" style="background-image:none; background-color: rgba(160,40,40,0.85); color:#FFD2D2; display:none;">Delete Course</button>
                </div>
            </form>

            <form method="POST" action="/admin/courses/delete" id="deleteCourseForm" style="display:none;">
                <input type="hidden" id="deleteCourseId" name="courseId">
            </form>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>
    <script>
        const query = new URLSearchParams(window.location.search);
        const saveStatus = document.getElementById('saveStatus');
        const courseForm = document.getElementById('courseForm');
        const courseId = document.getElementById('courseId');
        const courseName = document.getElementById('courseName');
        const courseDescription = document.getElementById('courseDescription');
        const saveBtn = document.getElementById('saveBtn');
        const deleteBtn = document.getElementById('deleteBtn');
        const deleteCourseForm = document.getElementById('deleteCourseForm');
        const deleteCourseId = document.getElementById('deleteCourseId');

        $('#htmlEditor').summernote({
            placeholder: 'Write course content here...',
            tabsize: 2,
            height: 480,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['insert', ['link', 'picture', 'video']],
                ['view', ['codeview']]
            ]
        });

        function applySaveStatus() {
            const save = query.get('save');
            if (!save) {
                return;
            }

            if (save === 'created') {
                saveStatus.classList.add('status-box--ok');
                saveStatus.textContent = 'Course created successfully.';
            } else if (save === 'updated') {
                saveStatus.classList.add('status-box--ok');
                saveStatus.textContent = 'Course updated successfully.';
            } else if (save === 'missing') {
                saveStatus.classList.add('status-box--err');
                saveStatus.textContent = 'Course name and description are required.';
            } else if (save === 'deleted') {
                saveStatus.classList.add('status-box--ok');
                saveStatus.textContent = 'Course deleted successfully.';
            } else if (save === 'invalid-delete') {
                saveStatus.classList.add('status-box--err');
                saveStatus.textContent = 'Invalid course selected for delete.';
            } else if (save === 'delete-error') {
                saveStatus.classList.add('status-box--err');
                saveStatus.textContent = 'Failed to delete course.';
            } else {
                saveStatus.classList.add('status-box--err');
                saveStatus.textContent = 'Failed to save course.';
            }
        }

        function switchToNewCourseMode() {
            courseId.value = '';
            courseName.value = '';
            courseDescription.value = '';
            $('#htmlEditor').summernote('code', '<p></p>');
            saveBtn.textContent = 'Save Course';
            deleteBtn.style.display = 'none';
            deleteCourseId.value = '';
        }

        document.getElementById('newBtn').addEventListener('click', switchToNewCourseMode);

        document.querySelectorAll('[data-load-course="true"]').forEach((button) => {
            button.addEventListener('click', () => {
                courseId.value = button.dataset.courseId || '';
                courseName.value = decodeURIComponent(button.dataset.courseName || '');
                courseDescription.value = decodeURIComponent(button.dataset.courseDescription || '');
                $('#htmlEditor').summernote('code', decodeURIComponent(button.dataset.courseHtml || '') || '<p></p>');
                saveBtn.textContent = 'Update Course';
                deleteBtn.style.display = 'inline-flex';
                deleteCourseId.value = button.dataset.courseId || '';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        deleteBtn.addEventListener('click', () => {
            if (!deleteCourseId.value) {
                return;
            }

            const confirmed = window.confirm('Delete this course permanently?');
            if (!confirmed) {
                return;
            }

            deleteCourseForm.submit();
        });

        applySaveStatus();
    </script>
</body>
</html>
