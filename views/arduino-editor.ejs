        ];

        // ─── CODE EDITOR ───────────────────────────────
        const defaultCode = TEMPLATES[0].code;

        const editor = CodeMirror.fromTextArea(document.getElementById('codeEditor'), {
            mode: 'text/x-c++src',
            theme: 'monokai',
            lineNumbers: true,
            matchBrackets: true,
            autoCloseBrackets: true,
            styleActiveLine: true,
            indentUnit: 4,
            tabSize: 4,
            indentWithTabs: false,
            lineWrapping: false,
            extraKeys: {
                'Ctrl-/': 'toggleComment',
                'Cmd-/': 'toggleComment',
                'Ctrl-S': function() { downloadSketch(); },
                'Ctrl-R': function() { compileCode(); },
                'Ctrl-U': function() { uploadCode(); }
            }
        });

        // Load saved code or use default
        const savedCode = localStorage.getItem('arduino_ide_code');
        editor.setValue(savedCode || defaultCode);

        // Auto-save every 3 seconds
        let saveTimeout;
        editor.on('change', () => {
            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                localStorage.setItem('arduino_ide_code', editor.getValue());
            }, 3000);
        });

        // Board select handler
        const boardSelect = document.getElementById('boardSelect');
        const savedBoard = localStorage.getItem('arduino_ide_board');
        if (savedBoard) boardSelect.value = savedBoard;

        boardSelect.addEventListener('change', () => {
            const board = boardSelect.value;
            const label = boardSelect.options[boardSelect.selectedIndex].text;
            document.getElementById('boardLabel').textContent = label;
            document.getElementById('boardInfo').textContent = label;
            localStorage.setItem('arduino_ide_board', board);
        });
        // Init label
        document.getElementById('boardLabel').textContent = boardSelect.options[boardSelect.selectedIndex].text;
        document.getElementById('boardInfo').textContent = boardSelect.options[boardSelect.selectedIndex].text;

        // ─── TEMPLATE MODAL ────────────────────────────
        const templateList = document.getElementById('templateList');
        TEMPLATES.forEach((t, i) => {
            const item = document.createElement('div');
            item.className = 'template-item';
            item.innerHTML = `<div class="t-name">${t.name}</div><div class="t-desc">${t.desc} (${t.board})</div>`;
            item.addEventListener('click', () => {
                editor.setValue(t.code);
                localStorage.setItem('arduino_ide_code', t.code);
                closeTemplateModal();
                setStatus('Loaded template: ' + t.name, 'ok');
            });
            templateList.appendChild(item);
        });

        window.openTemplateModal = function() {
            document.getElementById('templateModal').classList.add('active');
        };
        window.closeTemplateModal = function() {
            document.getElementById('templateModal').classList.remove('active');
        };

        // ─── STATUS HELPERS ────────────────────────────
        function setStatus(text, type) {
            const el = document.getElementById('statusLeft');
            el.textContent = text;
            el.className = 'status-text' + (type ? ' ' + type : '');
        }

        function appendCompileOutput(text, cls) {
            const el = document.getElementById('compileOutput');
            el.classList.add('active');
            const span = document.createElement('span');
            span.className = cls || '';
            span.textContent = text + '\n';
            el.appendChild(span);
            el.scrollTop = el.scrollHeight;
        }

        function clearCompileOutput() {
            const el = document.getElementById('compileOutput');
            el.innerHTML = '';
            el.classList.remove('active');
        }

        // ─── COMPILE ──────────────────────────────────
        window.compileCode = async function() {
            clearCompileOutput();
            const code = editor.getValue();
            const board = boardSelect.value;

            setStatus('Compiling...', 'busy');
            appendCompileOutput('=== Compiling for ' + boardSelect.options[boardSelect.selectedIndex].text + ' ===', 'co-info');
            appendCompileOutput('Board FQBN: ' + board, 'co-info');
            appendCompileOutput('', '');

            document.getElementById('compileBtn').disabled = true;
            document.getElementById('uploadBtn').disabled = true;

            try {
                const resp = await fetch('/api/arduino/compile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, board })
                });

                const result = await resp.json();

                if (result.success) {
                    appendCompileOutput('Compilation successful!', 'co-ok');
                    if (result.size) appendCompileOutput('Binary size: ' + result.size + ' bytes', 'co-info');
                    if (result.output) appendCompileOutput(result.output, '');
                    setStatus('Compilation successful', 'ok');
                    // Store binary for upload
                    window._compiledBinary = result.binary;
                    window._compiledFormat = result.format;
                } else {
                    appendCompileOutput('Compilation FAILED:', 'co-err');
                    appendCompileOutput(result.error || result.output || 'Unknown error', 'co-err');
                    setStatus('Compilation failed', 'err');
                    window._compiledBinary = null;
                }
            } catch (err) {
                appendCompileOutput('Network error: ' + err.message, 'co-err');
                appendCompileOutput('', '');
                appendCompileOutput('The compile server is not reachable.', 'co-warn');
                appendCompileOutput('', '');
                appendCompileOutput('SETUP OPTIONS:', 'co-info');
                appendCompileOutput('1. Deploy the compile microservice (see /arduino-compiler folder)', 'co-info');
                appendCompileOutput('   Push it to Railway.app or Render.com (free tier)', 'co-info');
                appendCompileOutput('   Then set ARDUINO_COMPILE_URL env var on Vercel', 'co-info');
                appendCompileOutput('', '');
                appendCompileOutput('2. Run locally: install arduino-cli and restart the server', 'co-info');
                appendCompileOutput('   https://arduino.github.io/arduino-cli/', 'co-info');
                appendCompileOutput('', '');
                appendCompileOutput('The Serial Monitor and code editor work without compilation.', 'co-ok');
                setStatus('Compile service unavailable', 'err');
            }

            document.getElementById('compileBtn').disabled = false;
            document.getElementById('uploadBtn').disabled = false;
        };

        // ─── UPLOAD VIA WEB SERIAL ─────────────────────
        window.uploadCode = async function() {
            // First compile
            await compileCode();

            if (!window._compiledBinary) {
                setStatus('No compiled binary. Fix errors first.', 'err');
                return;
            }

            if (!serialPort) {
                appendCompileOutput('', '');
                appendCompileOutput('No serial port connected. Click "Connect" first.', 'co-warn');
                appendCompileOutput('Attempting to open port for upload...', 'co-info');

                try {
                    await connectSerial();
                } catch {
                    setStatus('Upload failed: no serial port', 'err');
                    return;
                }
            }

            setStatus('Uploading...', 'busy');
            appendCompileOutput('', '');
            appendCompileOutput('=== Starting Upload ===', 'co-info');

            try {
                const binaryData = base64ToUint8Array(window._compiledBinary);
                const board = boardSelect.value;

                if (board.startsWith('esp32:')) {
                    await uploadESP32(binaryData);
                } else {
                    await uploadAVR(binaryData);
                }

                appendCompileOutput('Upload complete!', 'co-ok');
                setStatus('Upload successful!', 'ok');
            } catch (err) {
                appendCompileOutput('Upload error: ' + err.message, 'co-err');
                setStatus('Upload failed', 'err');
            }
        };

        function base64ToUint8Array(b64) {
            const raw = atob(b64);
            const arr = new Uint8Array(raw.length);
            for (let i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
            return arr;
        }

        // ─── STK500v1 UPLOAD (Arduino AVR) ─────────────
        const STK = {
            OK: 0x10, INSYNC: 0x14, CRC_EOP: 0x20,
            GET_SYNC: 0x30, GET_PARAMETER: 0x41,
            ENTER_PROGMODE: 0x50, LEAVE_PROGMODE: 0x51,
            LOAD_ADDRESS: 0x55, PROG_PAGE: 0x64,
            READ_SIGN: 0x75
        };

        async function uploadAVR(binaryData) {
            const writer = serialPort.writable.getWriter();
            let reader;
            const PAGE_SIZE = 128;

            // Close existing reader if any
            if (serialReader) {
                await serialReader.cancel();
                serialReader.releaseLock();
                serialReader = null;
            }

            reader = serialPort.readable.getReader();

            async function sendAndWait(data, timeout = 2000) {
                await writer.write(new Uint8Array(data));
                const start = Date.now();
                const response = [];

                while (Date.now() - start < timeout) {
                    try {
                        const { value, done } = await Promise.race([
                            reader.read(),
                            new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), timeout))
                        ]);
                        if (done) break;
                        if (value) response.push(...value);
                        if (response.length >= 2 && response[0] === STK.INSYNC) return response;
                    } catch {
                        break;
                    }
                }
                return response;
            }

            try {
                // Reset board via DTR toggle
                appendCompileOutput('Resetting board...', 'co-info');
                await serialPort.setSignals({ dataTerminalReady: false, requestToSend: false });
                await new Promise(r => setTimeout(r, 250));
                await serialPort.setSignals({ dataTerminalReady: true, requestToSend: true });
                await new Promise(r => setTimeout(r, 50));

                // Sync with bootloader
                appendCompileOutput('Syncing with bootloader...', 'co-info');
                let synced = false;
                for (let i = 0; i < 10; i++) {
                    const resp = await sendAndWait([STK.GET_SYNC, STK.CRC_EOP], 500);
                    if (resp.length >= 2 && resp[0] === STK.INSYNC && resp[1] === STK.OK) {
                        synced = true;
                        break;
                    }
                    await new Promise(r => setTimeout(r, 50));
                }
                if (!synced) throw new Error('Could not sync with bootloader. Is the board in bootloader mode?');
                appendCompileOutput('Bootloader synced!', 'co-ok');

                // Enter programming mode
                const enterResp = await sendAndWait([STK.ENTER_PROGMODE, STK.CRC_EOP]);
                if (!enterResp.length || enterResp[0] !== STK.INSYNC) {
                    throw new Error('Failed to enter programming mode');
                }
                appendCompileOutput('Programming mode entered', 'co-info');

                // Upload pages
                const totalPages = Math.ceil(binaryData.length / PAGE_SIZE);
                for (let page = 0; page < totalPages; page++) {
                    const addr = page * (PAGE_SIZE / 2); // Word address
                    const addrLow = addr & 0xFF;
                    const addrHigh = (addr >> 8) & 0xFF;

                    // Load address
                    await sendAndWait([STK.LOAD_ADDRESS, addrLow, addrHigh, STK.CRC_EOP]);

                    // Program page
                    const offset = page * PAGE_SIZE;
                    const pageData = binaryData.slice(offset, offset + PAGE_SIZE);
                    const padded = new Uint8Array(PAGE_SIZE);
                    padded.set(pageData);

                    const cmd = [STK.PROG_PAGE, 0x00, PAGE_SIZE, 0x46 /* 'F' for flash */];
                    cmd.push(...padded);
                    cmd.push(STK.CRC_EOP);

                    const progResp = await sendAndWait(cmd);
                    if (!progResp.length || progResp[0] !== STK.INSYNC) {
                        throw new Error('Failed to program page ' + page);
                    }

                    if (page % 10 === 0 || page === totalPages - 1) {
                        const pct = Math.round(((page + 1) / totalPages) * 100);
                        appendCompileOutput('Uploading... ' + pct + '%', 'co-info');
                        setStatus('Uploading: ' + pct + '%', 'busy');
                    }
                }

                // Leave programming mode
                await sendAndWait([STK.LEAVE_PROGMODE, STK.CRC_EOP]);
                appendCompileOutput('Programming mode exited', 'co-info');

            } finally {
                writer.releaseLock();
                reader.releaseLock();

                // Restart serial reading
                startSerialReading();
            }
        }

        // ─── ESP32 UPLOAD ──────────────────────────────
        async function uploadESP32(binaryData) {
            appendCompileOutput('ESP32 upload requires esptool.', 'co-warn');
            appendCompileOutput('Downloading compiled binary for manual flash...', 'co-info');

            // Offer binary download as fallback
            const blob = new Blob([binaryData], { type: 'application/octet-stream' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'firmware.bin';
            a.click();
            URL.revokeObjectURL(url);

            appendCompileOutput('Binary downloaded as firmware.bin', 'co-ok');
            appendCompileOutput('Flash with: esptool.py --port COM3 write_flash 0x10000 firmware.bin', 'co-info');
            appendCompileOutput('Or use ESP Flash Download Tool from Espressif', 'co-info');
        }

        // ─── WEB SERIAL API ───────────────────────────
        let serialPort = null;
        let serialReader = null;
        let serialReadLoop = false;

        async function connectSerial() {
            if (!('serial' in navigator)) {
                appendSerialOutput('Web Serial API not supported. Use Chrome/Edge 89+.', 'err');
                throw new Error('Web Serial not supported');
            }

            try {
                serialPort = await navigator.serial.requestPort();
                const baudRate = parseInt(document.getElementById('baudRate').value);
                await serialPort.open({ baudRate });

                document.getElementById('serialStatus').classList.add('connected');
                document.getElementById('serialStatus').title = 'Connected';
                document.getElementById('serialConnectBtn').textContent = 'Disconnect';
                document.getElementById('portInfo').textContent = 'Connected @ ' + baudRate + ' baud';
                document.getElementById('connectionStatus').textContent = 'Connected';

                appendSerialOutput('-- Connected at ' + baudRate + ' baud --', 'sys');
                setStatus('Serial connected', 'ok');

                startSerialReading();
            } catch (err) {
                if (err.name !== 'NotFoundError') {
                    appendSerialOutput('Connection error: ' + err.message, 'err');
                }
                throw err;
            }
        }

        async function disconnectSerial() {
            serialReadLoop = false;
            if (serialReader) {
                try {
                    await serialReader.cancel();
                    serialReader.releaseLock();
                } catch {}
                serialReader = null;
            }
            if (serialPort) {
                try { await serialPort.close(); } catch {}
                serialPort = null;
            }

            document.getElementById('serialStatus').classList.remove('connected');
            document.getElementById('serialStatus').title = 'Disconnected';
            document.getElementById('serialConnectBtn').textContent = 'Connect';
            document.getElementById('portInfo').textContent = 'Not connected';
            document.getElementById('connectionStatus').textContent = 'Idle';

            appendSerialOutput('-- Disconnected --', 'sys');
            setStatus('Serial disconnected', '');
        }

        window.toggleSerial = async function() {
            if (serialPort) {
                await disconnectSerial();
            } else {
                try {
                    await connectSerial();
                } catch {}
            }
        };

        function startSerialReading() {
            if (!serialPort || !serialPort.readable) return;
            serialReadLoop = true;

            (async () => {
                while (serialReadLoop && serialPort && serialPort.readable) {
                    try {
                        serialReader = serialPort.readable.getReader();
                        while (serialReadLoop) {
                            const { value, done } = await serialReader.read();
                            if (done) break;
                            if (value) {
                                const text = new TextDecoder().decode(value);
                                appendSerialOutput(text, 'rx');
                            }
                        }
                    } catch (err) {
                        if (serialReadLoop) {
                            appendSerialOutput('Read error: ' + err.message, 'err');
                        }
                    } finally {
                        if (serialReader) {
                            try { serialReader.releaseLock(); } catch {}
                            serialReader = null;
                        }
                    }
                }
            })();
        }

        window.sendSerial = async function() {
            if (!serialPort || !serialPort.writable) {
                appendSerialOutput('Not connected. Connect first.', 'err');
                return;
            }

            const input = document.getElementById('serialInput');
            const text = input.value;
            if (!text) return;

            const lineEnding = document.getElementById('lineEnding').value;
            const data = text + lineEnding;

            try {
                const writer = serialPort.writable.getWriter();
                const encoded = new TextEncoder().encode(data);
                await writer.write(encoded);
                writer.releaseLock();

                appendSerialOutput(text, 'tx');
                input.value = '';
            } catch (err) {
                appendSerialOutput('Send error: ' + err.message, 'err');
            }
        };

        let autoScroll = true;
        function appendSerialOutput(text, cls) {
            const el = document.getElementById('serialOutput');
            const span = document.createElement('span');
            span.className = cls || '';
            span.textContent = text + (cls !== 'rx' ? '\n' : '');
            el.appendChild(span);

            // Limit buffer
            while (el.children.length > 5000) {
                el.removeChild(el.firstChild);
            }

            if (autoScroll) el.scrollTop = el.scrollHeight;
        }

        window.clearSerial = function() {
            const el = document.getElementById('serialOutput');
            el.innerHTML = '<span class="sys">-- Serial Monitor Cleared --\n</span>';
        };

        // ─── DOWNLOAD SKETCH ───────────────────────────
        window.downloadSketch = function() {
            const code = editor.getValue();
            const blob = new Blob([code], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'sketch.ino';
            a.click();
            URL.revokeObjectURL(url);
            setStatus('Sketch downloaded', 'ok');
        };

        // ─── KEYBOARD SHORTCUTS ────────────────────────
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeTemplateModal();
                document.getElementById('compileOutput').classList.remove('active');
            }
        });

        // Handle serial port disconnect
        if ('serial' in navigator) {
            navigator.serial.addEventListener('disconnect', (e) => {
                if (serialPort === e.target) {
                    disconnectSerial();
                    appendSerialOutput('-- Port disconnected --', 'sys');
                }
            });
        }

        // ─── BAUD RATE CHANGE WHILE CONNECTED ──────────
        document.getElementById('baudRate').addEventListener('change', async () => {
            if (serialPort) {
                await disconnectSerial();
                await connectSerial();
            }
        });

    })();
    </script>
