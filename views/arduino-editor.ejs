<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Arduino IDE | Blueprint</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/theme/monokai.min.css">
    <style>
        @font-face { font-family: mcten; src: url('resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7;   src: url('resources/mc7.woff2')  format('woff2'); }

        *, *::before, *::after { box-sizing: border-box; }
        body, html {
            margin:0; padding:0; height:100%;
            overflow:hidden;
            font-family: mcten, monospace;
            font-size: clamp(14px, 2vw, 18px);
            cursor: url('resources/crosshair-32.png') 16 16, crosshair;
            line-height:1.4;
            background:#0a0a0a;
            color:#DDD;
        }
        a { color:#66aaff; text-decoration:none; cursor: url('resources/crosshair-32.png') 16 16, crosshair; }
        a:hover { color:#FFFFA0; }
        button, select, input { cursor: url('resources/crosshair-32.png') 16 16, crosshair; }

        ::-webkit-scrollbar { width:8px; height:8px; }
        ::-webkit-scrollbar-track { background:#0a0a0a; }
        ::-webkit-scrollbar-thumb { background:#333; border-radius:4px; }
        ::-webkit-scrollbar-thumb:hover { background:#555; }

        .bg-video {
            position:fixed; top:50%; left:50%;
            transform:translate(-50%,-50%);
            min-width:100%; min-height:100%;
            width:auto; height:auto;
            z-index:-1; object-fit:cover; opacity:0.12;
        }

        /* ── NAVBAR ───────────────────────────────────── */
        .navbar {
            position:fixed; top:0; left:0; right:0; height:50px;
            background:linear-gradient(180deg,#1a1a1ae8,#0a0a0aee);
            border-bottom:2px solid #333;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2, 0 4px 20px #0008;
            display:flex; justify-content:space-between; align-items:center;
            padding:0 1rem; z-index:100;
        }
        .nav-brand { display:flex; align-items:center; gap:.6rem; }
        .nav-logo { height:30px; image-rendering:pixelated; }
        .nav-title {
            color:#FFFFA0; font-family:'mc7',monospace;
            font-size:1rem; text-shadow:2px 2px #000A;
            letter-spacing:.05em;
        }
        .nav-controls { display:flex; gap:.5rem; align-items:center; }
        .nav-btn {
            padding:.3rem .7rem;
            border:2px solid #444;
            background:#3a3a3a url('resources/bgbtn.png') center/cover;
            image-rendering:pixelated;
            color:#DDD; font-family:'mc7',monospace; font-size:.65rem;
            cursor: url('resources/crosshair-32.png') 16 16, pointer;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF5;
            text-decoration:none; transition:all .15s;
        }
        .nav-btn:hover {
            color:#FFFFA0; border-color:#FFFFA0;
            transform:translateY(-1px);
        }
        .nav-btn:active { transform:translateY(1px); }
        .nav-btn.compile { border-color:#66aaff; color:#66aaff; }
        .nav-btn.compile:hover { border-color:#99ccff; color:#99ccff; box-shadow:0 0 8px #66aaff33; }
        .nav-btn.upload { border-color:#66ff66; color:#66ff66; }
        .nav-btn.upload:hover { border-color:#99ff99; color:#99ff99; box-shadow:0 0 8px #66ff6633; }
        .nav-btn.danger { background-image:none; background-color:rgba(160,40,40,0.85); color:#FFD2D2; }

        /* ── SELECT ───────────────────────────────────── */
        .mc-select {
            padding:.3rem .5rem;
            border:2px solid #444;
            background:#1a1a1a; color:#DDD;
            font-family:'mc7',monospace; font-size:.6rem;
            box-shadow:inset -2px -4px #0006, inset 2px 2px #FFF2;
            border-radius:2px; outline:none;
        }
        .mc-select:focus { border-color:#FFFFA0; }

        /* ── IDE LAYOUT ───────────────────────────────── */
        .ide-wrap {
            position:fixed; top:50px; left:0; right:0; bottom:0;
            display:grid;
            grid-template-columns:1fr 380px;
            grid-template-rows:1fr auto;
        }

        /* ── EDITOR PANEL ─────────────────────────────── */
        .editor-panel {
            grid-row:1/3; grid-column:1;
            display:flex; flex-direction:column;
            border-right:2px solid #333;
            min-width:0;
        }
        .editor-toolbar {
            display:flex; align-items:center; gap:.5rem;
            padding:.4rem .6rem;
            background:linear-gradient(180deg,#141414,#0e0e0e);
            border-bottom:1px solid #2a2a2a;
            flex-shrink:0;
        }
        .editor-toolbar label {
            color:#777; font-family:'mc7',monospace; font-size:.55rem;
            text-transform:uppercase; letter-spacing:.05em;
        }
        .file-name {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:.7rem;
            margin-left:auto;
        }
        .editor-container { flex:1; overflow:hidden; position:relative; }
        .editor-container .CodeMirror {
            height:100%; font-size:14px;
            font-family:'JetBrains Mono','Fira Code',monospace;
        }

        /* ── RIGHT PANEL ──────────────────────────────── */
        .right-panel {
            grid-row:1/3; grid-column:2;
            display:flex; flex-direction:column;
            min-height:0;
        }

        /* ── SERIAL MONITOR ───────────────────────────── */
        .serial-header {
            display:flex; align-items:center; gap:.4rem;
            padding:.4rem .6rem;
            background:linear-gradient(180deg,#141414,#0e0e0e);
            border-bottom:1px solid #2a2a2a;
            flex-shrink:0;
        }
        .serial-header .title-text {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:.7rem;
            text-shadow:1px 1px #000A;
        }
        .serial-header .spacer { flex:1; }

        .serial-status {
            width:8px; height:8px; border-radius:50%;
            background:#ff4444; border:1px solid #000;
            transition:background .3s;
        }
        .serial-status.connected { background:#44ff44; box-shadow:0 0 6px #44ff44; }

        .serial-output {
            flex:1; overflow-y:auto;
            background:#0a0a0a; padding:.5rem;
            font-family:'JetBrains Mono',monospace; font-size:12px;
            color:#0f0; white-space:pre-wrap; word-break:break-all;
            min-height:0;
            border-bottom:1px solid #2a2a2a;
        }
        .serial-output .rx { color:#0f0; }
        .serial-output .tx { color:#66aaff; }
        .serial-output .sys { color:#ff9944; font-style:italic; }
        .serial-output .err { color:#ff4444; }

        .serial-input-bar {
            display:flex; gap:0; flex-shrink:0;
            border-top:1px solid #2a2a2a;
        }
        .serial-input {
            flex:1; border:none; background:#111; color:#DDD;
            font-family:'JetBrains Mono',monospace; font-size:12px;
            padding:.4rem .5rem; outline:none;
        }
        .serial-input::placeholder { color:#555; }
        .serial-send-btn {
            padding:.4rem .7rem; background:#1a1a1a; border:none;
            border-left:1px solid #2a2a2a;
            color:#66ff66; font-family:'mc7',monospace; font-size:.6rem;
            cursor:pointer; transition:all .15s;
        }
        .serial-send-btn:hover { background:#2a2a2a; color:#99ff99; }

        /* ── BOARD INFO PANEL ─────────────────────────── */
        .board-info {
            padding:.5rem .6rem;
            background:linear-gradient(180deg,#141414,#0e0e0e);
            border-top:1px solid #2a2a2a;
            flex-shrink:0;
        }
        .board-info-row {
            display:flex; justify-content:space-between; align-items:center;
            margin-bottom:.3rem;
        }
        .board-info-label {
            color:#777; font-family:'mc7',monospace; font-size:.5rem;
            text-transform:uppercase;
        }
        .board-info-value {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:.55rem;
        }

        /* ── STATUS BAR (bottom) ──────────────────────── */
        .status-bar {
            position:fixed; bottom:0; left:0; right:0; height:24px;
            background:linear-gradient(180deg,#1a1a1a,#0e0e0e);
            border-top:1px solid #2a2a2a;
            display:flex; align-items:center; justify-content:space-between;
            padding:0 .8rem; z-index:100;
        }
        .status-text {
            color:#888; font-family:'mc7',monospace; font-size:.5rem;
        }
        .status-text.ok { color:#66ff66; }
        .status-text.err { color:#ff4444; }
        .status-text.busy { color:#ffcc44; }

        /* ── COMPILE OUTPUT DRAWER ────────────────────── */
        .compile-output {
            display:none; position:fixed; bottom:24px; left:0;
            right:380px; max-height:200px; overflow-y:auto;
            background:#0a0a0aee; border-top:2px solid #333;
            padding:.5rem .8rem;
            font-family:'JetBrains Mono',monospace; font-size:12px;
            color:#DDD; white-space:pre-wrap; z-index:90;
        }
        .compile-output.active { display:block; }
        .compile-output .co-err { color:#ff4444; }
        .compile-output .co-warn { color:#ffcc44; }
        .compile-output .co-ok { color:#66ff66; }
        .compile-output .co-info { color:#66aaff; }

        /* ── TEMPLATE MODAL ───────────────────────────── */
        .modal-overlay {
            display:none; position:fixed; inset:0; z-index:200;
            background:rgba(0,0,0,.88);
            justify-content:center; align-items:center;
        }
        .modal-overlay.active { display:flex; }
        .modal-card {
            background:linear-gradient(180deg,#141414,#0a0a0a);
            border:2px solid #444; padding:1.5rem;
            max-width:500px; width:90%; border-radius:6px;
            max-height:80vh; overflow-y:auto;
        }
        .modal-card h2 {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:1rem;
            text-shadow:2px 2px #000A; margin:0 0 1rem;
        }
        .template-list { display:grid; gap:.5rem; }
        .template-item {
            padding:.6rem .8rem;
            background:#1a1a1a; border:2px solid #2a2a2a;
            border-radius:4px; cursor:pointer; transition:all .15s;
        }
        .template-item:hover {
            border-color:#FFFFA0; transform:translateY(-1px);
        }
        .template-item .t-name {
            color:#FFFFA0; font-family:'mc7',monospace; font-size:.75rem;
        }
        .template-item .t-desc {
            color:#AAA; font-size:.65rem; margin-top:.2rem;
        }
        .modal-close {
            display:block; margin:1rem auto 0; padding:.3rem 1rem;
            background:#2a2a2a; border:1px solid #555;
            color:#DDD; font-family:'mc7',monospace; font-size:.65rem;
            cursor:pointer; border-radius:3px;
        }
        .modal-close:hover { color:#FFFFA0; border-color:#FFFFA0; }

        /* ── RESPONSIVE ───────────────────────────────── */
        @media (max-width:900px) {
            .ide-wrap {
                grid-template-columns:1fr;
                grid-template-rows:1fr 300px;
            }
            .editor-panel { grid-row:1; grid-column:1; border-right:none; border-bottom:2px solid #333; }
            .right-panel { grid-row:2; grid-column:1; }
            .compile-output { right:0; }
        }
        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, select, input { cursor: auto; }
        }
    </style>
    <link rel="icon" type="image/png" href="resources/logo.png">
</head>
<body>
    <video class="bg-video" autoplay muted loop playsinline>
