<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="theme-color" content="#000000">
    <title>Email Editor | Atlas Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css">
    <style>
        @font-face { font-family: mcten; src: url('/resources/mc10.woff2') format('woff2'); }
        @font-face { font-family: mc7; src: url('/resources/mc7.woff2') format('woff2'); }
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: mcten, monospace;
            cursor: url('/resources/crosshair-32.png') 16 16, crosshair;
            background-image: url('/resources/background.jpg');
            background-size: cover;
            background-position: center center;
            color: #DDD;
        }

        a, button, input, textarea { cursor: url('/resources/crosshair-32.png') 16 16, crosshair; }

        .page {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 1rem;
        }

        .card {
            border: 4px solid #000;
            background: linear-gradient(145deg, rgba(20,20,30,0.82), rgba(0,0,0,0.82));
            box-shadow: inset -3px -6px rgba(0,0,0,0.45), inset 3px 3px rgba(255,255,255,0.06);
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            font-family: 'mc7', monospace;
            color: #FFFFA0;
            font-size: clamp(20px, 2.6vw, 32px);
            text-shadow: 2px 2px #000A;
        }

        .subtitle {
            margin: 0.2rem 0 0;
            font-family: 'mc7', monospace;
            color: #90EE90;
            font-size: 0.82rem;
        }

        .mc-link,
        .btn {
            border: 2px solid #000;
            background: #999 url('/resources/bgbtn.png') center / cover;
            color: #DDD;
            text-decoration: none;
            font-family: 'mc7', monospace;
            text-shadow: 2px 2px #000A;
            padding: 0.7rem 0.85rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            transition: border-color 0.15s ease, filter 0.15s ease;
        }

        .mc-link:hover,
        .btn:hover,
        .mc-link:focus-visible,
        .btn:focus-visible {
            border-color: #FFFFA0;
            filter: brightness(1.08);
            outline: none;
        }

        .status {
            border: 2px solid #000;
            background: rgba(0,0,0,0.35);
            padding: 0.7rem 0.8rem;
            font-family: 'mc7', monospace;
            font-size: 0.8rem;
            margin-bottom: 0.8rem;
        }

        .status.ok { color: #90EE90; }
        .status.err { color: #ff8c8c; }

        .label {
            display: block;
            margin-bottom: 0.35rem;
            font-family: 'mc7', monospace;
            font-size: 0.86rem;
            color: #DDD;
        }

        .input,
        .textarea {
            width: 100%;
            border: 2px solid #000;
            background: #333 url('/resources/bgbtn.png') center / cover;
            color: #FFF;
            font-family: 'mc7', monospace;
            padding: 0.65rem 0.75rem;
            font-size: 0.88rem;
            box-shadow: inset -2px -4px #0006, inset 2px 2px #FFF3;
            margin-bottom: 0.75rem;
        }

        .textarea { min-height: 88px; resize: vertical; }

        .summernote-shell {
            border: 2px solid #000;
            border: 2px solid #000;
            background: #fff;
            box-shadow: inset -2px -3px #0005, inset 2px 2px #FFF2;
        }

        .note-editor.note-frame { border: 0; }
        .note-toolbar { background: #eef2f6; }

        .hint {
            margin-top: 0.4rem;
            color: #AAA;
            font-family: 'mc7', monospace;
            font-size: 0.74rem;
        }

        .btn-row {
            margin-top: 0.8rem;
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        @media (max-width: 820px) {
            .page {
                padding-left: calc(0.8rem + env(safe-area-inset-left, 0px));
                padding-right: calc(0.8rem + env(safe-area-inset-right, 0px));
                padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
                padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
            }

            .mc-link,
            .btn { width: 100%; }
        }

        @media (hover: none) and (pointer: coarse) {
            html, body, a, button, input, textarea { cursor: auto; }
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="card top">
            <div>
                <h1 class="title">EMAIL COMPOSER</h1>
                <p class="subtitle"><%= user.email %></p>
            </div>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a class="mc-link" href="/admin">← Back to Admin</a>
                <a class="mc-link" href="/logout">Logout</a>
            </div>
        </section>

        <section class="card">
            <div class="status" id="statusBox">Create rich email content with bold, links, colors, and images, then send to users.</div>

            <form method="POST" action="/admin/emails/send" id="emailForm">
                <label class="label" for="recipients">Recipients (comma-separated emails)</label>
                <textarea class="textarea" id="recipients" name="recipients" placeholder="member1@example.com, member2@example.com" required></textarea>

                <label class="label" for="subject">Subject</label>
                <input class="input" id="subject" name="subject" placeholder="Important Blueprint Update" required>

                <label class="label">Message Content</label>
                <div class="summernote-shell">
                    <textarea id="htmlEditor" name="htmlContent"><p>Write your message here...</p></textarea>
                </div>
                <p class="hint">Tip: use the Image button with a public image URL to embed images in the email.</p>

                <div class="btn-row">
                    <button class="btn" type="submit">Send Email</button>
                </div>
            </form>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>
    <script>
        const query = new URLSearchParams(window.location.search);
        const statusBox = document.getElementById('statusBox');

        $('#htmlEditor').summernote({
            placeholder: 'Write your message here...',
            tabsize: 2,
            height: 340,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['insert', ['link', 'picture']],
                ['view', ['codeview']]
            ]
        });

        const mail = query.get('mail');
        if (mail === 'sent') {
            statusBox.classList.add('ok');
            statusBox.textContent = 'Email sent successfully.';
        } else if (mail === 'missing') {
            statusBox.classList.add('err');
            statusBox.textContent = 'Recipients, subject, and content are required.';
        } else if (mail === 'gmail-missing') {
            statusBox.classList.add('err');
            statusBox.textContent = 'Gmail credentials are missing. Configure GMAIL_USER and GMAIL_APP_PASSWORD.';
        } else if (mail === 'error') {
            statusBox.classList.add('err');
            statusBox.textContent = 'Failed to send email.';
        }

    </script>
</body>
</html>
